service {

"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getOpenPOFinal" as "openPO"
	keys("PONUMBER","ITEMNO")
	//parameters via key and entity;
	parameters via entity;
	
"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getExclusionPOFinal" as "exclusionPO"
    keys generate local "ID"
	//parameters via key and entity;
	parameters via entity;
	
"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getThresholdPOFinal" as "threshold"
	keys("PONUMBER","ITEMNO")
	//parameters via key and entity;
	parameters via entity;

}
		
settings {
              support null;
              content cache-control "no-store";
              metadata cache-control "max-age=3600,must-revalidate";
              limits max_records = 100000;
}
	    
	