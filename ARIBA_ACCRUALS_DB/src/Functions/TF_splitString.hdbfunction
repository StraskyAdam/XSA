FUNCTION "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_splitString"( INPUT_STRING NCLOB)
	 RETURNS TABLE
(
"OUTPUT_SPLIT" VARCHAR(5000)
) 
       LANGUAGE SQLSCRIPT 
       SQL SECURITY INVOKER AS 
BEGIN 
   DECLARE COUNTER INT := 1;
   DECLARE LOC INT := 0;

--Check if Separator is in :INPUT_STRING 
SELECT LOCATE(:INPUT_STRING, ',') INTO LOC FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
IF LOC=0 THEN -- if not, use only :INPUT_STRING as Return Value
SPLIT_VALUES = SELECT TRIM(' ' FROM :INPUT_STRING) SINGLE_VAL FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
RETURN SELECT SINGLE_VAL AS "OUTPUT_SPLIT" FROM :SPLIT_VALUES; 
ELSE
SPLIT_VALUES = SELECT TRIM(' ' FROM SUBSTR_BEFORE(:INPUT_STRING,',')) SINGLE_VAL FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
SELECT TRIM(' ' FROM SUBSTR_AFTER(:INPUT_STRING,',')) || ',' INTO INPUT_STRING FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
END IF;

WHILE( LENGTH(:INPUT_STRING) > 0 )	
DO

   SPLIT_VALUES =	
   
   SELECT TRIM(' ' FROM SUBSTR_BEFORE(:INPUT_STRING,',')) SINGLE_VAL FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY"	 
UNION    
SELECT SINGLE_VAL FROM :SPLIT_VALUES;

   SELECT TRIM(' ' FROM SUBSTR_AFTER(:INPUT_STRING,',')) INTO INPUT_STRING FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
   
END WHILE;

RETURN

SELECT REPLACE(SINGLE_VAL,'''','') AS "OUTPUT_SPLIT" FROM :SPLIT_VALUES;

END;