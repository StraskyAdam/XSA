FUNCTION "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_getOpenThresholdPOReport"(IP_PSTYPE varchar(1), IP_EMAIL varchar(255),IP_POOWNER VARCHAR(1) )
       RETURNS table ( poowner_email varchar(255),
    			   companyCode nvarchar(4),
       			   purchasingUnit nvarchar(25),
       			   region varchar(3),
       			   cocdecurr varchar(5),
       			   glaccount varchar(5000),
       			   costcenter varchar(5000),
       			   costcenterDesc nvarchar(50),
       			   manageUnit varchar(35),
       			   PONUMBER nvarchar(10),
       			  -- docNumber varchar(10),
	               itemno nvarchar(5),
	               poCreatedAt date,
				   supplierID nvarchar(10),
				   suppliername varchar(500),
       			   polinedesc varchar(5000),
       			   pstype varchar(1),
       			   povalue decimal(13,2),
       			   pocurrency varchar(3),
       			   wrkStrtdate date,
       			   wrkEnddate date,
       			   totWrkCompAmt decimal(13,2),
       			   totWrkCompAmt_cocdecurr decimal(13,2),
       			   totWrkCompPer decimal(13,2),
              	  internalOrder varchar(5000),
              	   assetId varchar(12),
              	    profitCenter varchar(5000),
              	   epnumber varchar(12),
              	   status varchar(20),
              	   lastMonthwrkcomp decimal(13,2),
              	   straightlinemthd varchar(5),
              	    markasreviewed varchar(5),
              	   povalue_coco decimal(13,2),
              	   accrualMethod varchar(50),
              	   edgewtdamt decimal(13,2),
              	    changeddate date,
				 changedtime time,
				 reviwed_by varchar(225),
				  po_preparer varchar(241),
				  changed_on timestamp,
				  bbp_acc_no varchar(5000),
		     documentdate varchar(8),
		     purchasingorganization varchar(4),
		     orderquantity decimal(13,2),
		     exchangerate decimal(9,6),
		     pstype_text varchar(10),
		     distPercentage decimal(3,1),
		      quantity decimal(13,3),
		      povalue_usd decimal(13,2),
		      ZACTIVITYNBR nvarchar(200),
		      totWrkCompAmt_usd decimal(13,2)
       )
       LANGUAGE SQLSCRIPT 
       SQL SECURITY INVOKER AS 
BEGIN 

-- Get all the POs
lt_openPO_Detail = select * from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_getOpenAllThresholdPO"(:IP_PSTYPE, :IP_EMAIL,:IP_POOWNER);

-- Get the exclusion  POs
if :IP_PSTYPE = '*' then 
   lt_po_excluded = select * from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EDGE_EXCLUSIONPO" where pstype in ('0','9');
else 
	lt_po_excluded = select * from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EDGE_EXCLUSIONPO" where pstype = :IP_PSTYPE;
end if;



-- --Get all the PO's excluding exclusion PO's	 
lt_PODetails= select * from :lt_openPO_Detail
					where (PONUMBER,ITEMNO)not in (SELECT PONUMBER,ITEMNO FROM :lt_po_excluded);
					

-- Remove duplicate PO Number and Item number 
lt_finalPODetails =  select 
				  poowner_email ,
    			   companyCode ,
       			   purchasingUnit ,
       			   region ,
       			   cocdecurr ,
       			    glaccount,
       			    costcenter,
       			   null as costcenterDesc ,
       			   --manageUnit ,
       			    manageUnit,
       			   PONUMBER ,
	               itemno ,
	               poCreatedAt ,
				   supplierID ,
				   suppliername ,
       			   polinedesc ,
       			   pstype ,
       			   povalue ,
       			   pocurrency ,
       			   wrkStrtdate ,
       			   wrkEnddate ,
       			   totWrkCompAmt ,
       			   totWrkCompAmt_cocdecurr ,
       			   totWrkCompPer ,
              	    internalOrder,
              	   assetId ,
              	   profitCenter,
              	   epnumber ,
              	   status ,
              	   lastMonthwrkcomp ,
              	    (case when straightlinemthd ='X' then 'true'
              	   else 'false'
              	   end )as straightlinemthd,
              	   
              	   'false' as markasreviewed,
              	   povalue_coco ,
              	   (case when accrualMethod ='WTD' then 'Work To Date'
	              	   when accrualMethod='STL' then 'Straight Line'
	              	   else accrualMethod end) as accrualMethod,
              	   
              	   edgewtdamt ,
              	   changeddate ,
				 changedtime ,
				 reviwed_by,
				 po_preparer,
				 changed_on,
				   bbp_acc_no,
			     documentdate ,
			     purchasingorganization ,
			     orderquantity ,
			     exchangerate,
			     (case when PSTYPE='0' then 'Material'
					when PSTYPE='9' then 'Service'
					end
				)as pstype_text,
				distPercentage ,
				quantity,
				povalue_usd,
				ZACTIVITYNBR,
				case pocurrency
					when 'JPY' then 
						"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_ConvertCurrency"(totWrkCompAmt/100,pocurrency, 'USD', exchangerate).ev_targetAmount
					when 'VND' then 
						"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_ConvertCurrency"(totWrkCompAmt/100,pocurrency, 'USD', exchangerate).ev_targetAmount
					else 
						"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_ConvertCurrency"(totWrkCompAmt,pocurrency, 'USD', exchangerate).ev_targetAmount
				end   as totWrkCompAmt_usd
              	  
					-- STRING_AGG( ekkn.sakto, ',') as sakto,  -- GL Account
					-- STRING_AGG( ekkn.kostl, ',') as kostl,  -- Cost Center
					
					from :lt_PODetails ;
return :lt_finalPODetails;
end;
					