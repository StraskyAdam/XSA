FUNCTION "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_getOpenAllPO"( IP_PSTYPE varchar(1), 
																		IP_EMAIL varchar(255),
																		IP_POOWNER VARCHAR(1),
																		IP_THRESHOLD varchar(1) default '1'
																			
																		)
       RETURNS table (
       	           poowner_email varchar(255),
       			   companyCode nvarchar(4),
       			   purchasingUnit varchar(255),
       			   region varchar(3),
       			   cocdecurr varchar(5),
       			   glaccount varchar(10),
       			   costcenter varchar(10),
       			   costcenterDesc nvarchar(5000),
       			   manageUnit varchar(35),
       			   PONUMBER nvarchar(10),
       			  -- docNumber varchar(10),
	               itemno nvarchar(5),
	               poCreatedAt date,
				   supplierID nvarchar(10),
				   suppliername varchar(500),
       			   polinedesc varchar(5000),
       			   pstype varchar(1),
       			   povalue decimal(13,2),
       			   pocurrency varchar(3),
       			   invoice_currency varchar(3),
       			   wrkStrtdate date,
       			   wrkEnddate date,
       			   totWrkCompAmt decimal(13,2),
       			   totWrkCompAmt_cocdecurr decimal(13,2),
       			   totWrkCompPer decimal(13,2),--
              	   internalOrder varchar(12),
              	   assetId varchar(12),
              	   profitCenter varchar(10),
              	   epnumber varchar(12),
              	   status varchar(20),
              	   lastMonthwrkcomp decimal(13,2),
              	   straightlinemthd varchar(1),
              	     markasreviewed varchar(1),
              	   povalue_coco decimal(13,2),
              	   accrualMethod varchar(50),
              	   edgewtdamt decimal(13,2),
              	   changeddate date,
				   changedtime time,
				   reviwed_by varchar(225),
			      bbp_acc_no varchar(2),
				   documentdate varchar(8),
				   purchasingorganization varchar(4),
		           orderquantity decimal(13,2),
		  		   exchangerate decimal(9,6),
				   po_preparer varchar(241),
				   changed_on timestamp,
				     --mvp2
				   povalue_usd decimal(13,2),
				   po_closure varchar(5),
		    	  distPercentage decimal(3,1),
		    	    last_notif_on  timestamp,
			       notif_24_hr varchar(1),
			        quantity decimal(13,3),
			        ZACTIVITYNBR nvarchar(200)
              	 
     )
              
       LANGUAGE SQLSCRIPT 
       SQL SECURITY INVOKER AS 
BEGIN 
declare lv_config_value integer;
DECLARE lv_bukrs VARCHAR(5000);

-- Japan and Brazil ---

 select config_value into lv_bukrs from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
			where config_name = 'Japan_Brazil';

lt_values = select OUTPUT_SPLIT as company_code from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_splitString"(:lv_bukrs);

---End---


lt_config_value=select CONFIG_VALUE from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
where CONFIG_NAME='ACCRUAL_REVIEW_DATE';

lv_config_value=:lt_config_value.CONFIG_VALUE[1];

 -- Get the open POs
if :IP_PSTYPE = '*' then 
	lt_all_open_po = select * from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_getOpenPOQueryWithEmail"('1','9', :IP_EMAIL,:IP_POOWNER)
				 union all select * from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_getOpenPOQueryWithEmail"('1','0', :IP_EMAIL,:IP_POOWNER);

else
		lt_all_open_po = select * from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_getOpenPOQueryWithEmail"('1',:IP_PSTYPE, :IP_EMAIL,:IP_POOWNER);
end if;

lt_opn_po = select 
		    select_po.poowner_email as	 poowner_email,
		    T001.bukrs as companyCode,
		    T001.BUTXT as purchasingUnit,
		    T001.land1 as region,
		    T001.waers as cocdecurr,
		    LTRIM (ekkn.sakto,'0') as glaccount,
		    -- ekkn.kostl as costcenter,
		    LTRIM (ekkn.kostl,'0') as costcenter,
		    cskt.ltext as costcenterDesc,
		    -- csks.name1 as manageUnit,
		    csks.zzrptun as manageUnit,
	    	ekpo.ebeln as ponumber, 
	    	--mseg.mblnr as docNumber,
			ekpo.ebelp as itemno,
			to_dats(ekko.aedat) as poCreatedAt,
			ltrim(ekko.lifnr,'0') as supplierid,
			lfa1.name1 as suppliername,
			ekpo.txz01 as polinedesc,
			case when (ekpo.pstyp = '0' and T001.bukrs in (select company_code from :lt_values) and 
																			ekpo.zstart_date <> '00000000') then '9'
			else ekpo.pstyp end as pstype,
				-- In case of JPY and VND, multiple by 100
			case 
			 when ekko.waers = 'JPY' OR ekko.waers = 'VND'
				then ekpo.brtwr*100
			  else ekpo.brtwr
			end as povalue,
			-- ekpo.brtwr as povalue,
			ekko.waers as pocurrency,
			-- ekbe.waers as invoice_currency,
			 --"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_getInvoiceCurrency"(ekpo.ebeln,ekpo.ebelp) as invoice_currency,
			 ' ' as invoice_currency,
			to_dats(ekpo.zstart_date) as wrkStrtdate,
			to_dats(ekpo.zend_date) as wrkEnddate,
			-- ltrim(ekpo.zserv_amt) as totWrkCompAmt,
			 "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_accrualMethod"(
       			   																case 
																				 when ekko.waers = 'JPY'
																					then ekpo.brtwr*100
																				  else ekpo.brtwr
																				end ,
																				ekko.waers,
																				-- ekpo.pstyp,
																				case 
																					when ekpo.zstart_date <> '00000000' and ekpo.pstyp = '0'
																						and T001.bukrs in
																						(select company_code from :lt_values) then
																						'9'
																						else
																						ekpo.pstyp end,
																				to_dats(ekpo.zstart_date),
																				to_dats(ekpo.zend_date) ,
																				case 
																				when :IP_THRESHOLD = '2' and (ekpo.pstyp = '9' or 
																				(ekpo.pstyp = '0' and T001.bukrs in (select company_code from :lt_values) and 
																				ekpo.zstart_date <> '00000000'))
																				then 
																					'STL'
																				else edgePO.accrualMethod 
																				end ,
																				ltrim(ekpo.zserv_amt),
																				(case when ekpo.zserv_perc IN(' ', '') then 0.0
																					else ekpo.zserv_perc 
																					end ),
						       			   										 edgePO.totalworkcompltodate,
       			   																exchangeTab.exchange_rate
       			   ).TOTWRKCOMPAMT_OUT AS TOTWRKCOMPAMT,
			-- ltrim(ekpo.zserv_amt) as totWrkCompAmt_cocdecurr,
			 "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_accrualMethod"(	case 
																				 when ekko.waers = 'JPY' OR ekko.waers = 'VND'
																					then ekpo.brtwr*100
																				  else ekpo.brtwr
																				end ,
																				ekko.waers,
																				-- ekpo.pstyp,
																				case 
																					when ekpo.zstart_date <> '00000000' and ekpo.pstyp = '0'
																						and T001.bukrs in
																						(select company_code from :lt_values) then
																						'9'
																						else
																						ekpo.pstyp end,
																				to_dats(ekpo.zstart_date),
																				to_dats(ekpo.zend_date) ,
																				case 
																				when :IP_THRESHOLD = '2' and (ekpo.pstyp = '9' or 
																				(ekpo.pstyp = '0' and T001.bukrs in (select company_code from :lt_values) and 
																				ekpo.zstart_date <> '00000000'))
																				then 
																					'STL'
																				else edgePO.accrualMethod 
																				end ,
																				ltrim(ekpo.zserv_amt),
																				(case when ekpo.zserv_perc IN(' ', '') then 0.0
																					else ekpo.zserv_perc 
																					end ),
						       			   										 edgePO.totalworkcompltodate,
       			   																exchangeTab.exchange_rate
       			   ).totWrkCompAmt_usd_out as totWrkCompAmt_cocdecurr,
			 "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_accrualMethod"(		case 
																				 when ekko.waers = 'JPY' OR ekko.waers = 'VND'
																					then ekpo.brtwr*100
																				  else ekpo.brtwr
																				end,
																				ekko.waers,
																				-- ekpo.pstyp,
																				case 
																					when ekpo.zstart_date <> '00000000' and ekpo.pstyp = '0'
																						and T001.bukrs in
																						(select company_code from :lt_values) then
																						'9'
																						else
																						ekpo.pstyp end,
																				to_dats(ekpo.zstart_date),
																				to_dats(ekpo.zend_date) ,
																				case 
																				when :IP_THRESHOLD = '2' and (ekpo.pstyp = '9' or 
																				(ekpo.pstyp = '0' and T001.bukrs in (select company_code from :lt_values) and 
																				ekpo.zstart_date <> '00000000'))
																				then 
																					'STL'
																				else edgePO.accrualMethod 
																				end ,
																				ltrim(ekpo.zserv_amt),
																				(case when ekpo.zserv_perc IN(' ', '') then 0.0
																					else ekpo.zserv_perc 
																					end ),
						       			   										 edgePO.totalworkcompltodate,
       			   																exchangeTab.exchange_rate
				   ).totWrkCompPer_out as totWrkCompPer,
			LTRIM (ekkn.aufnr,'0') as internalOrder,
			ltrim(ekkn.anln1,'0') as assetId,
			ekkn.prctr as profitCenter,
			ekko.unsez as epNumber,
			(case
					when edgePO.PO_CLOSURE = 'true' then 'Reviewed'
        			when status='Reviewed' then
								 case 
								 	when year(changeddate) < year(current_date) then 
								 												case 
								 													when extract( day from current_date) between '1' and '6' 
																										then case when months_between(changeddate,current_date) = 0 then 'Reviewed'
																											else 'Pending' end 
																					when extract( day from  current_date) >= 7  then 'Pending'
																				end	
									when year(changeddate) = year(current_date)  then
                                            										case 
                                            											when month(changeddate) < month(current_date)  then  
                                            																						 case 
                                            																							when month(changeddate)-month(current_date) = -1 then 
																																			case 
																																				when extract( day from current_date) between '1' and '6' 
																																				then 
																																					case when months_between(changeddate,current_date) = 0 then 'Reviewed'
																																					else 'Pending'
																																					end 
																																				when extract( day from  current_date) >= 7  then 'Pending'
																																			end	
																																		else 'Pending'
																																		end 
																																		
	
                                            											when month(changeddate) = month(current_date) then 
                                                																					case 
                                                																						when extract(day from changeddate) =:lv_config_value and  extract(day from current_date) = :lv_config_value then 'Reviewed'
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) >= :lv_config_value then 'Pending'
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) < :lv_config_value then 'Reviewed'
                                                																						when extract(day from changeddate) > :lv_config_value  and  extract(day from current_date) > :lv_config_value then 'Reviewed'
                                                																						when extract(day from changeddate) = :lv_config_value  and  extract(day from current_date) > :lv_config_value then 'Reviewed'
                                                																					
                                                																					end
                                            											end
                                            

                                    end                                             

            	when edgePO.status='Pending' then 'Pending'
            	when edgePO.status is null then 'Pending'
                  end )as status,
			edgePO.workcomplastmonthamt as lastMonthwrkcomp,

			"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_accrualMethod"(	case 
																				 when ekko.waers = 'JPY' OR ekko.waers = 'VND'
																					then ekpo.brtwr*100
																				  else ekpo.brtwr
																				end ,
																				ekko.waers,
																				-- ekpo.pstyp,
																				case 
																					when ekpo.zstart_date <> '00000000' and ekpo.pstyp = '0'
																						and T001.bukrs in
																						(select company_code from :lt_values) then
																						'9'
																						else
																						ekpo.pstyp end,
																				to_dats(ekpo.zstart_date),
																				to_dats(ekpo.zend_date) ,
																				case 
																				when :IP_THRESHOLD = '2' and (ekpo.pstyp = '9' or 
																				(ekpo.pstyp = '0' and T001.bukrs in (select company_code from :lt_values) and 
																				ekpo.zstart_date <> '00000000'))
																				then 
																					'STL'
																				else edgePO.accrualMethod 
																				end ,
																				ltrim(ekpo.zserv_amt),
																				(case when ekpo.zserv_perc IN(' ', '') then 0.0
																					else ekpo.zserv_perc 
																					end ),
						       			   										 edgePO.totalworkcompltodate,
       			   																exchangeTab.exchange_rate
              	   ).straightlinemthd as straightlinemthd,
			/* Mark As Reviewed */
				  (case
        			when status='Reviewed' then
								 case 
								 	when year(changeddate) < year(current_date) then 
								 													case 
								 													when extract( day from current_date) between '1' and '6' 
																										then case when months_between(changeddate,current_date) = 0 then markasreviewed
																											else NULL end 
																					when extract( day from  current_date) >= 7  then NULL
																				end	
								 	
									when year(changeddate) = year(current_date)  then
                                            										case 
                                            											when month(changeddate) < month(current_date)  then 
                                            																								case
                                            																								when month(changeddate)-month(current_date) = -1 then 
																																			case 
																																				when extract( day from current_date) between '1' and '6' 
																																				then 
																																					case when months_between(changeddate,current_date) = 0 then markasreviewed
																																					else NULL
																																					end 
																																				when extract( day from  current_date) >= 7  then NULL
																																			end	
																																		else NULL
																																		end 
                                            											when month(changeddate) = month(current_date) then 
                                                																					case 
                                                																						when extract (day from changeddate) =:lv_config_value and  extract(day from current_date) = :lv_config_value then markasreviewed
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) >= :lv_config_value then NULL
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) < :lv_config_value then markasreviewed
                                                																						when extract(day from changeddate) > :lv_config_value  and  extract(day from current_date) > :lv_config_value then markasreviewed
                                                																						when extract(day from changeddate) = :lv_config_value  and  extract(day from current_date) > :lv_config_value then markasreviewed
                                                																					
                                                																					end
                                            											end
                                            

                                    end                                            

            	when edgePO.status='Pending' then edgePO.markasreviewed
            	when edgePO.status is null then edgePO.markasreviewed
                  end  ) as markasreviewed,
			-- 	AS povalue_coco,
			-- In case of JPY AND VND, multiple by 100
			case 
			 when ekko.waers = 'JPY' OR  ekko.waers = 'VND'
				then ekpo.brtwr*100
			  else ekpo.brtwr
			end as povalue_coco,
			"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_accrualMethod"(	case 
																				 when ekko.waers = 'JPY' OR ekko.waers = 'VND'
																					then ekpo.brtwr*100
																				  else ekpo.brtwr
																				end ,
																				ekko.waers,
																				-- ekpo.pstyp,
																				case 
																					when ekpo.zstart_date <> '00000000' and ekpo.pstyp = '0'
																						and T001.bukrs in
																						(select company_code from :lt_values) then
																						'9'
																						else
																						ekpo.pstyp end,
																				to_dats(ekpo.zstart_date),
																				to_dats(ekpo.zend_date) ,
																				case 
																				when :IP_THRESHOLD = '2' and (ekpo.pstyp = '9' or 
																				(ekpo.pstyp = '0' and T001.bukrs in (select company_code from :lt_values) and 
																				ekpo.zstart_date <> '00000000')) 
																				then 
																					'STL'
																				else edgePO.accrualMethod 
																				end ,
																				ltrim(ekpo.zserv_amt),
																				(case when ekpo.zserv_perc IN(' ', '') then 0.0
																					else ekpo.zserv_perc 
																					end ),
						       			   										 edgePO.totalworkcompltodate,
       			   																exchangeTab.exchange_rate).accrualMethod_out as accrualMethod,
		    edgePO.totalworkcompltodate as edgewtdamt,
		    (case
        			when status='Reviewed' then
								 case 
								 	when year(changeddate) < year(current_date) then 
								 												case 
								 													when extract( day from current_date) between '1' and '6' 
																										then case when months_between(changeddate,current_date) = 0 then changeddate
																											else ' ' end 
																					when extract( day from  current_date) >= 7  then ' '
																					end
									when year(changeddate) = year(current_date)  then
                                            										case 
                                            											when month(changeddate) < month(current_date)  then 
                                            																							case
                                            																								when month(changeddate)-month(current_date) = -1 then 
																																			case 
																																				when extract( day from current_date) between '1' and '6' 
																																				then 
																																					case when months_between(changeddate,current_date) = 0 then changeddate
																																					else ' '
																																					end 
																																				when extract( day from  current_date) >= 7  then ' '
																																			end	
																																		else ' '
																																		end 
                                            											when month(changeddate) = month(current_date) then 
                                            											
                                                																					case 
                                                																						when extract (day from changeddate) =:lv_config_value and  extract(day from current_date) = :lv_config_value then changeddate
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) >= :lv_config_value then ' '
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) < :lv_config_value then changeddate
                                                																						when extract(day from changeddate) > :lv_config_value  and  extract(day from current_date) > :lv_config_value then changeddate
                                                																						when extract(day from changeddate) = :lv_config_value  and  extract(day from current_date) > :lv_config_value then changeddate
                                                																					
                                                																					end
                                            											end
                                            

                                    end                                           
                                    

            	when edgePO.status='Pending' then edgePO.changeddate
            	when edgePO.status is null then edgePO.changeddate
                  end ) as changeddate,
		    (case
        			when status='Reviewed' then
								 case 
								 	when year(changeddate) < year(current_date) then 
								 													case 
								 													when extract( day from current_date) between '1' and '6' 
																										then case when months_between(changeddate,current_date) = 0 then changedtime
																											else ' ' end 
																					when extract( day from  current_date) >= 7  then ' '
																					end
									when year(changeddate) = year(current_date)  then
                                            										case 
                                            											when month(changeddate) < month(current_date)  then 	
                                            																							case
                                            																								when month(changeddate)-month(current_date) = -1 then 
																																			case 
																																				when extract( day from current_date) between '1' and '6' 
																																				then 
																																					case when months_between(changeddate,current_date) = 0 then changedtime
																																					else ' '
																																					end 
																																				when extract( day from  current_date) >= 7  then ' '
																																			end	
																																		else ' '
																																		end
                                            											when month(changeddate) = month(current_date) then 
                                                																					case 
                                                																						when extract (day from changeddate) =:lv_config_value and  extract(day from current_date) = :lv_config_value then changedtime
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) >= :lv_config_value then ' '
                                                																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) < :lv_config_value then changedtime
                                                																						when extract(day from changeddate) > :lv_config_value  and  extract(day from current_date) > :lv_config_value then changedtime
                                                																						when extract(day from changeddate) = :lv_config_value  and  extract(day from current_date) > :lv_config_value then changedtime
                                                																					
                                                																					end
                                            											end
                                            

                                    end                                       

            	when edgePO.status='Pending' then edgePO.changedtime
            	when edgePO.status is null then edgePO.changedtime
                  end ) as changedtime,
		    		-- (case
        -- 			when status='Reviewed' then
								--  case 
								--  	when year(changeddate) < year(current_date) then reviwed_by
								--  												-- 	case 
								--  												-- 	when extract( day from current_date) between '1' and '6' 
								-- 													-- 					then reviwed_by
								-- 													-- 					case when months_between(changeddate,current_date) = 0 then reviwed_by
								-- 													-- 						else ' ' end 
								-- 													-- when extract( day from  current_date) >= 7  then ' '
																					
								--  													-- end
								-- 	when year(changeddate) = year(current_date)  then
        --                                     										case 
        --                                     											when month(changeddate) < month(current_date)  then reviwed_by
        --                           --          																								case
        --                           --          																								when month(changeddate)-month(current_date) = -1 then 
								-- 																										-- 	case 
								-- 																										-- 		when extract( day from current_date) between '1' and '6' 
								-- 																										-- 		then 
								-- 																										-- 			case when months_between(changeddate,current_date) = 0 then reviwed_by
								-- 																										-- 			else ' '
								-- 																										-- 			end 
								-- 																										-- 		when extract( day from  current_date) >= 7  then ' '
																																				
								-- 																										-- 	end	
								-- 																										-- else ' '
																																		
								-- 																										-- end
        --                                     											when month(changeddate) = month(current_date) then 
        --                                         																					case 
        --                                         																						when extract (day from changeddate) =:lv_config_value and  extract(day from current_date) = :lv_config_value then reviwed_by
        --                                         																						-- when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) >= :lv_config_value then ' '
        --                                         																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) >= :lv_config_value then reviwed_by
        --                                         																						when  extract(day from changeddate) < :lv_config_value  and  extract(day from current_date) < :lv_config_value then reviwed_by
        --                                         																						when extract(day from changeddate) > :lv_config_value  and  extract(day from current_date) > :lv_config_value then reviwed_by
        --                                         																						when extract(day from changeddate) = :lv_config_value  and  extract(day from current_date) > :lv_config_value then reviwed_by
                                                																					
        --                                         																					end
        --                                     											end
                                            

        --                             end                                             

        --     	when edgePO.status='Pending' then edgePO.reviwed_by
        --     	when edgePO.status is null then edgePO.reviwed_by
        --           end  )
    		edgePO.reviwed_by as reviwed_by,
		    ekkn.zekkn as bbp_acc_no,
		    ekko.bedat as documentdate,
		    ekko.ekorg as purchasingorganization,
		    ekpo.menge as orderquantity,
		    exchangeTab.exchange_rate as exchangerate,
		    LOWER(ekpo.PO_PREPARER) as po_preparer,
			UTCTOLOCAL(edgePO.changed_on,'CET') as changed_on,
------->>>>>>>>> MVP2 Changes>>>>>>>>>------- 
			-- PO Value in USD 
			 "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::SF_ConvertCurrency"(ekpo.brtwr,ekko.waers, 'USD', exchangeTab.exchange_rate).ev_targetAmount as povalue_usd,
             edgePO.PO_CLOSURE AS po_closure,
            -- Distribution Percentage
            ekkn.vproz as distPercentage,
            UTCTOLOCAL(POLINE.last_notif_on,'CET') as last_notif_on,
            poline.notif_24_hr as notif_24_hr,
            ekkn.menge as quantity,
            ekpo.ZACTIVITYNBR
-------<<<<<<<<<< MVP2 Changes <<<<<<<<<<>------- 
			from :lt_all_open_po as select_po 
			left outer join (select ebeln, ebelp, menge, txz01, pstyp, brtwr, zstart_date, zend_date,
							zserv_amt, zserv_perc, po_preparer, po_requestor,ZACTIVITYNBR
					        from	"ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::EKPO.EKPO" ) as ekpo
			on select_po.ebeln = ekpo.ebeln 
			and  select_po.ebelp = ekpo.ebelp
			left outer join (select ebeln, bukrs,bedat, ekorg, waers, aedat, lifnr, unsez 
								from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::EKKO.EKKO" ) as ekko
			on ekpo.ebeln = ekko.ebeln
			left outer  join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::LFA1.LFA1" as lfa1
			on ekko.lifnr = lfa1.lifnr
			left outer  join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::T001.T001" as T001
			on ekko.bukrs = T001.bukrs
			left outer  join  (select ebeln, ebelp,kokrs, sakto, kostl, aufnr, anln1, prctr, zekkn, vproz,menge
							from  "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::EKKN.EKKN" 
							
			) as ekkn
			on ekkn.ebeln = ekpo.ebeln 
			and ekkn.ebelp = ekpo.ebelp
			
			-- 	left outer  join  (select ebeln, ebelp,waers
			-- 				from  "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::EKBE.EKBE" 
							
			-- ) as ekbe
			
			-- on ekbe.ebeln = ekpo.ebeln 
			-- and ekbe.ebelp = ekpo.ebelp
			
			left outer join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::CSKT.CSKT" as cskt
			on cskt.kostl = ekkn.kostl
			and cskt.spras  = 'E' 
			and cskt.kokrs = ekkn.kokrs
			and cskt.datbi >= CURRENT_DATE
			left outer join  "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::CSKS.CSKS" as csks
			on csks.kostl = ekkn.kostl
			and csks.kokrs = ekkn.kokrs
			and csks.datbi >= CURRENT_DATE
			left join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EDGE_SERVICEPO_STATUS" as edgePO
			on edgepo.ponumber = ekpo.ebeln 
			and edgepo.lineitem = ekpo.ebelp
			left join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EDGE_EXCHANGERATE" as exchangeTab
			on ekko.waers = exchangeTab.source_curr
			left outer join ( select ponumber, 
							  lineitem, 
							  MAX(CHANGEDON) AS last_notif_on, 
							  (CASE WHEN DAYS_BETWEEN(CURRENT_UTCTIMESTAMP,MAX(POLINE.CHANGEDON)) = 0 then 'X'
								else ''
								end )as notif_24_hr
								from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_POLINE_AUDIT" as POLINE
							 group by ponumber, lineitem 
				
			) as poline
			on 	POLINE.PONUMBER = ekpo.ebeln  AND 
				POLINE.LINEITEM = ekpo.ebelp;

			

return :lt_opn_po;
END;