PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::jobSchedulerWD2Dates"( )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   READS SQL DATA AS
BEGIN

	-- Raw config values
    DECLARE RAW_NOTIF_DATE  VARCHAR(50);
    
    -- Default day value
    DECLARE DEFAULT_NOTIF_DAY  INT := 24;
    
    -- Final notification date
	DECLARE MANAGER_NOTIF_DATE VARCHAR(50);

	-- Get the last day of the current month
    DECLARE V_DAYS_IN_MONTH INT;
    SELECT DAYOFMONTH(LAST_DAY(CURRENT_DATE)) INTO v_days_in_month FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
    
    -- Fetch raw manager notification day
    SELECT 
       CONFIG_VALUE  
    INTO RAW_NOTIF_DATE
    FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
    WHERE CONFIG_NAME = 'MANAGER_REMINDER_DATE';
    
    -- Validate (null, blank, invalid characters, and date if exceeds calendar days)
    -- and assign defaults as fallback as needed
    
  	IF RAW_NOTIF_DATE IS NULL THEN
    	MANAGER_NOTIF_DATE := DEFAULT_NOTIF_DAY;
	ELSEIF TRIM(RAW_NOTIF_DATE) = '' THEN
	    MANAGER_NOTIF_DATE := DEFAULT_NOTIF_DAY;
	ELSEIF RAW_NOTIF_DATE NOT LIKE_REGEXPR '^[0-9]+$' THEN
		MANAGER_NOTIF_DATE := DEFAULT_NOTIF_DAY;
	ELSEIF NOT TO_INT(TRIM(RAW_NOTIF_DATE)) BETWEEN 1 AND V_DAYS_IN_MONTH THEN  
	    MANAGER_NOTIF_DATE := DEFAULT_NOTIF_DAY;
	ELSEIF TO_INT(RAW_NOTIF_DATE) > V_DAYS_IN_MONTH THEN
	    MANAGER_NOTIF_DATE := DEFAULT_NOTIF_DAY;
	ELSE
    	MANAGER_NOTIF_DATE := TO_INT(TRIM(RAW_NOTIF_DATE));
	END IF;
	
     -- Output the full date
    SELECT TO_DATE(TO_VARCHAR(CURRENT_DATE, 'YYYY-MM') || '-' || MANAGER_NOTIF_DATE, 'YYYY-MM-DD') AS JOB_DATE
    FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";

END
