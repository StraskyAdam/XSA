PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::deleteEmailTemplate"(IV_TEMPLATE_NAME VARCHAR(100),
																			 IV_LANGUAGE VARCHAR(2),
																			OUT EX_STATUS VARCHAR(50),
	                                                                        OUT EX_cODE INTEGER )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
  -- READS SQL DATA
   AS
BEGIN
 delete from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EMAIL_TEMPLATE_CONFIG"  
 where template_name = :IV_TEMPLATE_NAME and 
		language = :IV_LANGUAGE;
		
	EX_STATUS :='Record deleted successfully !';
	EX_CODE := 1;
END