PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::deleteConfigValues"( ip_name varchar(50),
	                                                                        ip_value varchar(255),                                              
																			OUT EX_STATUS VARCHAR(50),
	                                                                        OUT EX_cODE INTEGER )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
  -- READS SQL DATA 
 AS
BEGIN

delete from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
where  config_name = ip_name
and config_value = ip_value;

EX_STATUS :='Record deleted successfully !';
EX_CODE := 1;

END