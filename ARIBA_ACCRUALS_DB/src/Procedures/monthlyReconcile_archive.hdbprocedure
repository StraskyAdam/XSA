PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::monthlyReconcile_archive"( )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   --READS SQL DATA 
   AS
BEGIN

UPDATE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_MONTHLY_RECONCILIATION"
SET "ARCHIVE_FLAG" = 'Yes', "ARCHIVED_ON" = CURRENT_TIMESTAMP
WHERE "ARCHIVE_FLAG" IS NULL;
	
END