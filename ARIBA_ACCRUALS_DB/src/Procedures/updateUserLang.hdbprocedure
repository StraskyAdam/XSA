PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::updateUserLang"(IP_EMAIL VARCHAR(225),
																		IP_LANG VARCHAR(5))
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   --READS SQL DATA 
   AS
BEGIN
 UPSERT "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_USER_LANGUAGE"(
 																		"EMAIL_ID",
 																		"LANGUAGE"
 )
 VALUES(:IP_EMAIL,:IP_LANG)
 WHERE EMAIL_ID=:IP_EMAIL;
END