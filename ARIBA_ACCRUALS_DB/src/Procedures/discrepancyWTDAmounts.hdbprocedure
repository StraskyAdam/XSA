PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::discrepancyWTDAmounts"( )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   READS SQL DATA AS
BEGIN
  
declare lv_bukrs varchar(5000);  
  -- Japan_Brazil
 select config_value into lv_bukrs from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
			where config_name = 'Japan_Brazil';
			
lt_values = select OUTPUT_SPLIT as company_code from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_splitString"(:lv_bukrs);
  
  lt_discrepancy=select	ekpo.ebeln as ebeln,
		ekpo.ebelp as ebelp,
		ekpo.waers as currency,
		to_decimal(((ltrim(zserv_perc) * ekpo.brtwr)/100),18,2) as calculated,
		(case when ekpo.waers='JPY' OR ekpo.waers='VND' then to_decimal(round((ltrim(zserv_amt)/ekpo.brtwr),1),18,1) 
			 else to_decimal(round((ltrim(zserv_amt)/ekpo.brtwr)*100,1),18,1) 
			 end)as ServiceCompletedPercentageCalculated,
		(case when ekpo.waers='JPY' OR ekpo.waers='VND' THEN to_decimal(ltrim(ekpo.zserv_amt)/100,18,2)
			  else to_decimal(ltrim(ekpo.zserv_amt),18,2) 
			  end) as sapServiceCompleted  ,
		to_decimal(ltrim(ekpo.zserv_perc),18,1) as sapPercentage,
		(case when ekpo.accrualmethod is null or  ekpo.accrualmethod IN(' ', '') then 'WTD'
				else ekpo.accrualmethod 
				end )as accrualMethod,
		ekpo.brtwr as povalue,
		ekpo.reviewedBy ,
		ekpo.changed_on ,
		ekpo.zstart_date as work_startdate,
		ekpo.zend_date as work_enddate,
		ekpo.bukrs as companycode
		-- 'Error' as status,
		-- 'Service Completetd Percentage mismatch' as message
				from (
						select ekpo.ebeln,ekpo.ebelp,ltrim(ekpo.zserv_perc) as zserv_perc ,ltrim(ekpo.zserv_amt) as zserv_amt,
						ekpo.erekz,ekpo.zstart_date,ekpo.zend_date,(case when ekko.waers ='JPY' OR ekko.waers ='VND' THEN ekpo.brtwr * 100
																			else ekpo.brtwr
																			end) as brtwr,
						ekpo.pstyp,ekko.waers,edge.changed_on as changed_on,edge.reviwed_by as reviewedBy,edge.accrualmethod,ekpo.bukrs
						
						from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::EKPO.EKPO" as ekpo
						left outer join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::EKKO.EKKO" as ekko
							on ekko.ebeln = ekpo.ebeln
						left outer join  "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EDGE_SERVICEPO_STATUS"  as edge
							on ekpo.ebeln=edge.ponumber and ekpo.ebelp=edge.lineitem
						where 
						-- (ltrim(ekpo.zserv_amt) <> '0.00'
						 ltrim(ekpo.zserv_amt) <> ''
						and ltrim(ekpo.zserv_perc) <> '0.0'
						and ltrim(ekpo.zserv_perc)<>''
					
				-- )
						and ekpo.pstyp='9' and ekpo.EREKZ IN(' ', '')
						and ekpo.zstart_date <> '00000000' and ekpo.zend_date <> '00000000'
						and (ekpo.pstyp = '0' and ekpo.zstart_date <> '00000000'
							and ekpo.bukrs in (select company_code from :lt_values))
						and ekko.bsart = 'ZARP'
						and ekpo.brtwr>=0.01
				) as ekpo
				inner join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::T001.T001" as T001
				on ekpo.bukrs = T001.bukrs
				left outer join "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EDGE_EXCHANGERATE" as rate
				on ekpo.waers=rate.source_curr
				where 
				 --( ltrim(ekpo.zserv_amt) <> '0.00' or
				 ltrim(ekpo.zserv_amt) <> '' 
				 --)--WTD
				and ltrim(ekpo.zserv_perc)<>'' and  ltrim(ekpo.zserv_perc)<>'0.0';
			
  
  
  	
  
lt_filtered_records=  select ebeln,ebelp,currency,ServiceCompletedPercentageCalculated,sapPercentage,
					  ABS(sapPercentage-ServiceCompletedPercentageCalculated) as serviceCompletedPercentDiff,
					  --ABS((sapServiceCompleted-calculated)*100)/povalue as calculatedPercent,
					  sapServiceCompleted,accrualmethod,povalue,
					  reviewedBy,changed_on,
					  (calculated-sapServiceCompleted) as servicecomplamtdiff,companycode,
					  (case when sapServiceCompleted > povalue then 'Error'
							when ABS(sapPercentage-ServiceCompletedPercentageCalculated) > 1 then 'Error'
					  end )as status,
					  (case when sapServiceCompleted > povalue then 'Service Completed Amount is greater than Po Value'
							when ABS(sapPercentage-ServiceCompletedPercentageCalculated) > 1 then 'Service Completed Percentage Mismatch'
					  end )as Message
					  from :lt_discrepancy
					  where  accrualmethod <> 'STL' and povalue >= 0.01
					  and (ebeln,ebelp) not in (select ponumber, itemno from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_EDGE_EXCLUSIONPO" where pstype in ('9'));--excluding exclusion PO's
  	
  	
select  * from :lt_filtered_records
where
(status='Error' and serviceCompletedPercentDiff > 1) and 
povalue >= 0.01;
							     	
			
END
