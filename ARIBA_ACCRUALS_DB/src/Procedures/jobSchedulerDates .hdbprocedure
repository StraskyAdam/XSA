PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::jobSchedulerDates "( )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   READS SQL DATA AS
BEGIN

    -- Raw config values
    DECLARE RAW_FIRST  VARCHAR(50);
    DECLARE RAW_SECOND VARCHAR(50);
    DECLARE RAW_THIRD  VARCHAR(50);
    
    -- Default day values
    DECLARE DEFAULT_FIRST_DAY  INT := 15;
    DECLARE DEFAULT_SECOND_DAY INT := 20;
    DECLARE DEFAULT_THIRD_DAY  INT := 26;

	-- Final notification dates
	DECLARE FIRST_NOTIF_DATE VARCHAR(50);
	DECLARE SECOND_NOTIF_DATE VARCHAR(50);
	DECLARE THIRD_NOTIF_DATE VARCHAR(50);
	
	-- Get the last day of the current month
    DECLARE V_DAYS_IN_MONTH INT;
    SELECT DAYOFMONTH(LAST_DAY(CURRENT_DATE)) INTO V_DAYS_IN_MONTH FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
	
    -- Fetch raw values from config
    SELECT 
        MAX(CASE WHEN CONFIG_NAME = '1ST_REVIEW_NOTIFICATION_DATE' THEN CONFIG_VALUE END),
        MAX(CASE WHEN CONFIG_NAME = '2ND_REVIEW_NOTIFICATION_DATE' THEN CONFIG_VALUE END),
        MAX(CASE WHEN CONFIG_NAME = '3RD_REVIEW_NOTIFICATION_DATE' THEN CONFIG_VALUE END)
    INTO RAW_FIRST, RAW_SECOND, RAW_THIRD
    FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
    WHERE CONFIG_NAME IN (
        '1ST_REVIEW_NOTIFICATION_DATE',
        '2ND_REVIEW_NOTIFICATION_DATE',
        '3RD_REVIEW_NOTIFICATION_DATE'
    );
    
    -- Validate (null, blank, invalid characters, and date if exceeds calendar days)
    -- and assign defaults as fallback as needed
    
    -- First day
	IF RAW_FIRST IS NULL THEN
    	FIRST_NOTIF_DATE := DEFAULT_FIRST_DAY;
	ELSEIF TRIM(RAW_FIRST) = '' THEN
	    FIRST_NOTIF_DATE := DEFAULT_FIRST_DAY;
	ELSEIF RAW_FIRST NOT LIKE_REGEXPR '^[0-9]+$' THEN
    	FIRST_NOTIF_DATE := DEFAULT_FIRST_DAY;
	ELSEIF NOT TO_INT(TRIM(RAW_FIRST)) BETWEEN 1 AND V_DAYS_IN_MONTH THEN 
	    FIRST_NOTIF_DATE := DEFAULT_FIRST_DAY;
	ELSEIF TO_INT(RAW_FIRST) > V_DAYS_IN_MONTH THEN
	    FIRST_NOTIF_DATE := DEFAULT_FIRST_DAY;
	ELSE
    	FIRST_NOTIF_DATE := TO_INT(TRIM(RAW_FIRST));
	END IF;
	
	-- Second day
	IF RAW_SECOND IS NULL THEN
    	SECOND_NOTIF_DATE := DEFAULT_SECOND_DAY;
	ELSEIF TRIM(RAW_SECOND) = '' THEN
	    SECOND_NOTIF_DATE := DEFAULT_SECOND_DAY;
	ELSEIF RAW_SECOND NOT LIKE_REGEXPR '^[0-9]+$' THEN
		SECOND_NOTIF_DATE := DEFAULT_SECOND_DAY;
	ELSEIF NOT TO_INT(TRIM(RAW_SECOND)) BETWEEN 1 AND V_DAYS_IN_MONTH THEN 
	    SECOND_NOTIF_DATE := DEFAULT_SECOND_DAY;
	ELSEIF TO_INT(RAW_SECOND) > V_DAYS_IN_MONTH THEN
	    SECOND_NOTIF_DATE := DEFAULT_SECOND_DAY;
	ELSE
    	SECOND_NOTIF_DATE := TO_INT(TRIM(RAW_SECOND));
	END IF;
	
    -- Third day
	IF RAW_THIRD IS NULL THEN
    	THIRD_NOTIF_DATE := DEFAULT_THIRD_DAY;
	ELSEIF TRIM(RAW_THIRD) = '' THEN
	    THIRD_NOTIF_DATE := DEFAULT_THIRD_DAY;
	ELSEIF RAW_THIRD NOT LIKE_REGEXPR '^[0-9]+$' THEN
		THIRD_NOTIF_DATE := DEFAULT_THIRD_DAY;
	ELSEIF NOT TO_INT(TRIM(RAW_THIRD)) BETWEEN 1 AND V_DAYS_IN_MONTH THEN  
	    THIRD_NOTIF_DATE := DEFAULT_THIRD_DAY;
	ELSEIF TO_INT(RAW_THIRD) > V_DAYS_IN_MONTH THEN
	    THIRD_NOTIF_DATE := DEFAULT_THIRD_DAY;
	ELSE
    	THIRD_NOTIF_DATE := TO_INT(TRIM(RAW_THIRD));
	END IF;
   
    
	-- Output the full dates
    SELECT TO_DATE(TO_VARCHAR(CURRENT_DATE, 'YYYY-MM') || '-' || FIRST_NOTIF_DATE, 'YYYY-MM-DD') AS JOB_DATE
    FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY"
    UNION
    SELECT TO_DATE(TO_VARCHAR(CURRENT_DATE, 'YYYY-MM') || '-' || SECOND_NOTIF_DATE, 'YYYY-MM-DD') AS JOB_DATE
    FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY"
    UNION
    SELECT TO_DATE(TO_VARCHAR(CURRENT_DATE, 'YYYY-MM') || '-' || THIRD_NOTIF_DATE, 'YYYY-MM-DD') AS JOB_DATE
    FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::DUMMY";
    

END
