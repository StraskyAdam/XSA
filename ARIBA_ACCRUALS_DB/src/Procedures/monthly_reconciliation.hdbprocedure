	 (case when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Services PO'
		when PSTYPE='0' then 'Material PO'
		when PSTYPE='9' then 'Services PO'
		end
	)as "PSTYPE",
	(case when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Below Threshold PO Service'
		when PSTYPE='0' then 'Below Threshold PO Material'
		when PSTYPE='9' then 'Below Threshold PO Service'
		end
	)as "PO_DASHBOARD_SECTION",
	AMOUNTACCRUED_USD,
	STATUS,
	GRVALUE_USD,
	MANAGEUNIT,
	AMOUNTACCRUED,
	STRAIGHTLINEMTHD,
	REVIWED_BY,
	CHANGED_ON,
	REGION,
	POCREATEDAT,
	INVVALUE_USD,
	TOTWRKCOMPPER,
	NULL AS RULETYPE,
	NULL AS RULETYPETEXT,
	POVALUE_USD,
	totWrkCompAmt_usd,
