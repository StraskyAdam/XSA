PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::monthly_reconciliation"( )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   --READS SQL DATA 
   AS
BEGIN

DECLARE lv_bukrs VARCHAR(5000);

 select config_value into lv_bukrs from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
			where config_name = 'Japan_Brazil';

lt_values = select OUTPUT_SPLIT as company_code from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_splitString"(:lv_bukrs);

lt_data =
 	SELECT 
	to_date((current_utctimestamp)) as JOB_DATE,
	"COMPANYCODE",
	"COSTCENTER",
	"GLACCOUNT",
	"POOWNER_EMAIL",
	to_dats(to_date(last_day(current_utctimestamp))) AS "KEYDAY",
	"BBP_ACC_NO",
	"PONUMBER",
	"ITEMNO",
	"INTERNALORDER",
	to_dats(to_date("DOCUMENTDATE")) as DOCUMENTDATE,
	"POLINEDESC",
	"SUPPLIERID",
	"SUPPLIERNAME",
	"SUPPLIERID" AS VENDOR,
	"PURCHASINGORGANIZATION",
	"ASSETID",
	"PROFITCENTER",
	-- yyyymmdd format in FTP server
	to_dats(to_date("WRKSTRTDATE")) as WRKSTRTDATE ,
	to_dats(to_date("WRKENDDATE")) as WRKENDDATE,
	"COCDECURR",
	"POCURRENCY",
	SUM("ORDERQUANTITY") AS "ORDERQUANTITY",
	SUM("POVALUE") AS "POVALUE",
	SUM("INVVALUE") AS "InvoiceAmountClearedOrig",
	-- (case when "INVVALUE" > 0 and DISTPERCENTAGE >0 then to_decimal((INVVALUE * DISTPERCENTAGE)/100,18,2)
	-- 	 when "INVVALUE" > 0 and DISTPERCENTAGE =0 then  to_decimal(INVVALUE,18,2)
	--  else 0.00 end )AS "InvoiceAmountClearedOrig" ,
	SUM("EXCHANGERATE") AS "EXCHANGERATE",
	-- mvp2
		(case when "AMOUNTACCRUED" > 0 then 
					-- case when DISTPERCENTAGE >0 and QUANTITY >0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE)/100,18,2)
					--  WHEN DISTPERCENTAGE=0 and QUANTITY >1 then to_decimal((AMOUNTACCRUED * QUANTITY)/100,18,2)
					--   WHEN DISTPERCENTAGE=0 and QUANTITY =1 then to_decimal((AMOUNTACCRUED * QUANTITY),18,2)
					--  when DISTPERCENTAGE >0 and QUANTITY =0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE )/100,18,2)
					-- end 
					case when DISTPERCENTAGE >0 and QUANTITY >0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE)/100,18,2)
					 WHEN DISTPERCENTAGE=0 and QUANTITY >1 then to_decimal((AMOUNTACCRUED * 1)/1,18,2)
					  WHEN DISTPERCENTAGE=0 and QUANTITY =1 then to_decimal((AMOUNTACCRUED * 1),18,2)
					  WHEN DISTPERCENTAGE= 0 and QUANTITY BETWEEN 0 and 1 AND "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_recordCount"("PONUMBER", "ITEMNO", '') = 1
					  then to_decimal((AMOUNTACCRUED * 1),18,2)
					  
					  WHEN DISTPERCENTAGE= 0 and QUANTITY BETWEEN 0 and 1 AND "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_recordCount"("PONUMBER", "ITEMNO", '') > 1
					  then to_decimal((AMOUNTACCRUED * QUANTITY),18,2)
					 when DISTPERCENTAGE >0 and QUANTITY =0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE )/100,18,2)
					end 
			else 0.00
			end )AS "AmountToBeAccruedOrig" ,
	  (case when "AMOUNTACCRUED_COCDECURR" >0 then AMOUNTACCRUED_COCDECURR
	 else 0 end )AS "AmountToBeAccruedComp",
	 POVALUE AS PO_VALUE,
	 TOTWRKCOMPAMT,
	 GRVALUE_1,
	 ACCRUALMETHOD,
	 PO_PREPARER,
	 (case	when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Services PO'
		when PSTYPE='0' then 'Material PO'
		when PSTYPE='9' then 'Services PO'
		end
	)as "PSTYPE",
	(case when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Indirect Services'
		when PSTYPE='0' then 'Indirect Material'
		when PSTYPE='9' then 'Indirect Services'
		end
	)as "PO_DASHBOARD_SECTION",
	 AMOUNTACCRUED_USD,
	 STATUS,
	 GRVALUE_USD,
	 MANAGEUNIT,
	 AMOUNTACCRUED,
	 STRAIGHTLINEMTHD,
	 REVIWED_BY,
	 CHANGED_ON,
	 REGION,
	 POCREATEDAT,
	 INVVALUE_USD,
	 TOTWRKCOMPPER,
	 NULL AS RULETYPE,
	 NULL AS RULETYPETEXT,
	 POVALUE_USD,
	 totWrkCompAmt_usd,
	 EPNUMBER
	 	 

FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getOpenPOReport"
	(placeholder."$$IP_PSTYPE$$"=>'9', 
	placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'')

GROUP BY 	"COMPANYCODE",
	"COSTCENTER",

	"GLACCOUNT",
	"POOWNER_EMAIL",
	-- KEY DATE,
	"BBP_ACC_NO",
	"PONUMBER",
	"ITEMNO",
	"INTERNALORDER",
	"DOCUMENTDATE",
	"POLINEDESC",
	"SUPPLIERID",
	"SUPPLIERNAME",
	-- "SUPPLIERID" AS VENDOR,
	"PURCHASINGORGANIZATION",
	"ASSETID",
	"PROFITCENTER",
	"WRKSTRTDATE",
	"WRKENDDATE",
	-- "WRKSTRTDATE_FTP","WRKENDDATE_FTP",
	"COCDECURR",
	"POCURRENCY",
	 "AMOUNTACCRUED",
	 DISTPERCENTAGE,
	 QUANTITY,
	"AMOUNTACCRUED_COCDECURR",
	INVVALUE,
	TOTWRKCOMPAMT,
	GRVALUE_1,
	ACCRUALMETHOD,
	PO_PREPARER,
	AMOUNTACCRUED_USD,
	STATUS,
	GRVALUE_USD,
	MANAGEUNIT,
	AMOUNTACCRUED,
	STRAIGHTLINEMTHD,
	REVIWED_BY,
	CHANGED_ON,
	REGION,
	POCREATEDAT,
	INVVALUE_USD,
	POVALUE,
	PSTYPE,
	TOTWRKCOMPPER,
	POVALUE_USD,
	totWrkCompAmt_usd,
	EPNUMBER
union 
	SELECT 
	to_date((current_utctimestamp)) as JOB_DATE,
	"COMPANYCODE",
	"COSTCENTER",
	"GLACCOUNT",
	"POOWNER_EMAIL",
	to_dats(to_date(last_day(current_utctimestamp))) AS "KEYDAY",
	"BBP_ACC_NO",
	"PONUMBER",
	"ITEMNO",
	"INTERNALORDER",
	to_dats(to_date("DOCUMENTDATE")) as DOCUMENTDATE,
	"POLINEDESC",
	"SUPPLIERID",
	"SUPPLIERNAME",
	"SUPPLIERID" AS VENDOR,
	"PURCHASINGORGANIZATION",
	"ASSETID",
	"PROFITCENTER",
	-- yyyymmdd format in FTP server
	to_dats(to_date("WRKSTRTDATE")) as WRKSTRTDATE ,
	to_dats(to_date("WRKENDDATE")) as WRKENDDATE,
	"COCDECURR",
	"POCURRENCY",
	SUM("ORDERQUANTITY") AS "ORDERQUANTITY",
	SUM("POVALUE") AS "POVALUE",
	SUM("INVVALUE") AS "InvoiceAmountClearedOrig",
	-- (case when "INVVALUE" > 0 and DISTPERCENTAGE >0 then to_decimal((INVVALUE * DISTPERCENTAGE)/100,18,2)
	-- 	 when "INVVALUE" > 0 and DISTPERCENTAGE =0 then  to_decimal(INVVALUE,18,2)
	--  else 0.00 end )AS "InvoiceAmountClearedOrig" ,
	SUM("EXCHANGERATE") AS "EXCHANGERATE",
	-- mvp2
		(case when "AMOUNTACCRUED" > 0 then 
					-- case when DISTPERCENTAGE >0 and QUANTITY >0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE)/100,18,2)
					--  WHEN DISTPERCENTAGE=0 and QUANTITY >1 then to_decimal((AMOUNTACCRUED * QUANTITY)/100,18,2)
					--   WHEN DISTPERCENTAGE=0 and QUANTITY =1 then to_decimal((AMOUNTACCRUED * QUANTITY),18,2)
					--  when DISTPERCENTAGE >0 and QUANTITY =0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE )/100,18,2)
					-- end
					case when DISTPERCENTAGE >0 and QUANTITY >0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE)/100,18,2)
					 WHEN DISTPERCENTAGE=0 and QUANTITY >1 then to_decimal((AMOUNTACCRUED * 1)/1,18,2)
					  WHEN DISTPERCENTAGE=0 and QUANTITY =1 then to_decimal((AMOUNTACCRUED * 1),18,2)
					  WHEN DISTPERCENTAGE= 0 and QUANTITY BETWEEN 0 and 1 AND "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_recordCount"("PONUMBER", "ITEMNO", '') = 1
					  then to_decimal((AMOUNTACCRUED * 1),18,2)
					  
					  WHEN DISTPERCENTAGE= 0 and QUANTITY BETWEEN 0 and 1 AND "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_recordCount"("PONUMBER", "ITEMNO", '') > 1
					  then to_decimal((AMOUNTACCRUED * QUANTITY),18,2)
					 when DISTPERCENTAGE >0 and QUANTITY =0 then to_decimal((AMOUNTACCRUED * DISTPERCENTAGE )/100,18,2)
					end 
			else 0.00
			end )AS "AmountToBeAccruedOrig" ,
	  (case when "AMOUNTACCRUED_COCDECURR" >0 then AMOUNTACCRUED_COCDECURR
	 else 0 end )AS "AmountToBeAccruedComp",
	 POVALUE AS PO_VALUE,
	 TOTWRKCOMPAMT,
	 GRVALUE_1,
	 ACCRUALMETHOD,
	 PO_PREPARER,
	 (case when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Services PO'
		when PSTYPE='0' then 'Material PO'
		when PSTYPE='9' then 'Services PO'
		end
	)as "PSTYPE",
	(case when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Indirect Services'
		when PSTYPE='0' then 'Indirect Material'
		when PSTYPE='9' then 'Indirect Services'
		end
	)as "PO_DASHBOARD_SECTION",
	AMOUNTACCRUED_USD,
	STATUS,
	GRVALUE_USD,
	MANAGEUNIT,
	AMOUNTACCRUED,
	STRAIGHTLINEMTHD,
	REVIWED_BY,
	CHANGED_ON,
	REGION,
	POCREATEDAT,
	INVVALUE_USD,
	TOTWRKCOMPPER,
	NULL AS RULETYPE,
	NULL AS RULETYPETEXT,
	POVALUE_USD,
	totWrkCompAmt_usd,
	EPNUMBER
	 	 

FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getOpenPOReport"
	(placeholder."$$IP_PSTYPE$$"=>'0', 
	placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'')

GROUP BY 	"COMPANYCODE",
	"COSTCENTER",
QUANTITY,
	"GLACCOUNT",
	"POOWNER_EMAIL",
	-- KEY DATE,
	"BBP_ACC_NO",
	"PONUMBER",
	"ITEMNO",
	"INTERNALORDER",
	"DOCUMENTDATE",
	"POLINEDESC",
	"SUPPLIERID",
	"SUPPLIERNAME",
	-- "SUPPLIERID" AS VENDOR,
	"PURCHASINGORGANIZATION",
	"ASSETID",
	"PROFITCENTER",
