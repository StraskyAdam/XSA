FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getOpenThresholdPOReportPO"
	(placeholder."$$IP_PSTYPE$$"=>'9', 
	placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'')
	
GROUP BY 	"COMPANYCODE",
	"COSTCENTER",
	"GLACCOUNT",
	"POOWNER_EMAIL",
	QUANTITY,
	"BBP_ACC_NO",
	"PONUMBER",
	"ITEMNO",
	"INTERNALORDER",
	"DOCUMENTDATE",
	"POLINEDESC",
	"SUPPLIERID",
	"SUPPLIERNAME",
	-- "SUPPLIERID" AS VENDOR,
	"PURCHASINGORGANIZATION",
	"ASSETID",
	"PROFITCENTER",
	"WRKSTRTDATE",
	"WRKENDDATE",
		-- "WRKSTRTDATE_FTP","WRKENDDATE_FTP",
	"COCDECURR",
	"POCURRENCY",
	 "AMOUNTACCRUED",
	 DISTPERCENTAGE,
	"AMOUNTACCRUED_COCDECURR",
	INVVALUE,
	TOTWRKCOMPAMT,
	GRVALUE_1,
	ACCRUALMETHOD,
	PO_PREPARER,
	AMOUNTACCRUED_USD,
	STATUS,
	GRVALUE_USD,
	MANAGEUNIT,
	AMOUNTACCRUED,
	STRAIGHTLINEMTHD,
	REVIWED_BY,
	CHANGED_ON,
	REGION,
	POCREATEDAT,
	INVVALUE_USD,
	POVALUE,
	PSTYPE,
	TOTWRKCOMPPER,
	POVALUE_USD,
