	-- "SUPPLIERID" AS VENDOR,
	"PURCHASINGORGANIZATION",
	"ASSETID",
	"PROFITCENTER",
	"WRKSTRTDATE",
	"WRKENDDATE",
		-- "WRKSTRTDATE_FTP","WRKENDDATE_FTP",
	"COCDECURR",
	"POCURRENCY",
	 "AMOUNTACCRUED",
	 DISTPERCENTAGE,
	"AMOUNTACCRUED_COCDECURR",
	INVVALUE,
	TOTWRKCOMPAMT,
	GRVALUE_1,
	ACCRUALMETHOD,
	PO_PREPARER,
	AMOUNTACCRUED_USD,
	STATUS,
	GRVALUE_USD,
	MANAGEUNIT,
	AMOUNTACCRUED,
	STRAIGHTLINEMTHD,
	REVIWED_BY,
	CHANGED_ON,
	REGION,
	POCREATEDAT,
	INVVALUE_USD,
	POVALUE,
	PSTYPE,
	TOTWRKCOMPPER,
	POVALUE_USD,
	totWrkCompAmt_usd,
	EPNUMBER
	union
	SELECT 

	to_date((current_utctimestamp)) as JOB_DATE,
	"COMPANYCODE",
	"COSTCENTER",
	"GLACCOUNT",
	"POOWNER_EMAIL",
	to_dats(to_date(last_day(current_utctimestamp))) AS "KEYDAY",
	 "BBP_ACC_NO",
	"PONUMBER",
	"ITEMNO",
	"INTERNALORDER",
	to_dats(to_date("DOCUMENTDATE")) as DOCUMENTDATE,
	"POLINEDESC",
	"SUPPLIERID",
	"SUPPLIERNAME",
	"SUPPLIERID" AS VENDOR,
	null as	"PURCHASINGORGANIZATION",
	"ASSETID",
	"PROFITCENTER",
	-- to_date("WRKSTRTDATE") as WRKSTRTDATE ,
	-- to_date("WRKENDDATE") as WRKENDDATE,
	-- yyyymmdd format in FTP server
	to_dats(to_date("WRKSTRTDATE")) as WRKSTRTDATE ,
	to_dats(to_date("WRKENDDATE")) as WRKENDDATE,
	"COCDECURR",
	"POCURRENCY",
	0 AS "ORDERQUANTITY",
	SUM("POVALUE") AS "POVALUE",
	SUM("INVVALUE") AS "InvoiceAmountClearedOrig",
		-- (case when "INVVALUE" > 0 and DISTPERCENTAGE >0 then to_decimal((INVVALUE * DISTPERCENTAGE)/100,18,2)
		--  when "INVVALUE" > 0 and DISTPERCENTAGE =0 then  to_decimal(INVVALUE,18,2)
	 --else 0.00 end )AS "InvoiceAmountClearedOrig" ,
	0 AS "EXCHANGERATE",
	 0 AS "AmountToBeAccruedOrig" ,
	  0 AS "AmountToBeAccruedComp",
	  POVALUE AS PO_VALUE,
	  TOTWRKCOMPAMT,
	  GRVALUE,
	  ACCRUALMETHOD,
	  PO_PREPARER,
	  (case when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Services PO'
		when PSTYPE='0' then 'Material PO'
		when PSTYPE='9' then 'Services PO'
		end
	)as "PSTYPE",
	(case when (PSTYPE='0' and WRKSTRTDATE <> '00000000' and COMPANYCODE in (select company_code from :lt_values)) then 'Exclusion Indirect Service'
		when PSTYPE='0' then 'Exclusion Indirect Material'
		when PSTYPE='9' then 'Exclusion Indirect Service'
		end
	)as "PO_DASHBOARD_SECTION",
	'0' AS AMOUNTACCRUED_USD,
	STATUS,
	GRVALUE_USD,
	MANAGEUNIT,
	'0' AS AMOUNTACCRUED,
	STRAIGHTLINEMTHD,
	'' AS REVIWED_BY,
	CHANGED_ON,
	REGION,
	POCREATEDAT,
	INVVALUE_USD,
	TOTWRKCOMPPER,
	RULETYPE,
	RULETYPETEXT,
	POVALUE_USD,
	totWrkCompAmt_usd,
	EPNUMBER

FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getExclusionPOReport"
	(
	placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'')

GROUP BY 	"COMPANYCODE",
	"COSTCENTER",
	"GLACCOUNT",
	"POOWNER_EMAIL",
	"BBP_ACC_NO",
	"PONUMBER",
	"ITEMNO",
	"INTERNALORDER",
	"POLINEDESC",
	"SUPPLIERID",
	"SUPPLIERNAME",
	"ASSETID",
	"PROFITCENTER",
	"WRKSTRTDATE",
	"WRKENDDATE",
	"COCDECURR",
	"POCURRENCY",
	INVVALUE,
	DOCUMENTDATE,
	DISTPERCENTAGE,
	TOTWRKCOMPAMT,
	GRVALUE,
	ACCRUALMETHOD,
	PO_PREPARER,
	--AMOUNTACCRUED_USD,
	STATUS,
	GRVALUE_USD,
	MANAGEUNIT,
	-- AMOUNTACCRUED,
	STRAIGHTLINEMTHD,
	-- REVIWED_BY,
	CHANGED_ON,
	REGION,
	POCREATEDAT,
	INVVALUE_USD,
	POVALUE,
	PSTYPE,
	TOTWRKCOMPPER,
	RULETYPE,
	RULETYPETEXT,
	POVALUE_USD,
	totWrkCompAmt_usd,
	EPNUMBER
;
	 
	-- DELETE FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_MONTHLY_RECONCILIATION";
	-- UPDATE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_MONTHLY_RECONCILIATION"
	-- SET "ARCHIVE_FLAG" = 'Yes', "ARCHIVED_ON" = CURRENT_TIMESTAMP
	-- WHERE "ARCHIVE_FLAG" IS NULL;
	
	INSERT INTO "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_MONTHLY_RECONCILIATION"
		(
			COMPANY_CODE,
			COST_CENTER,
			GL_ACCOUNT,
			PO_OWNER,
			POSTING_DATE,
			SPLIT_ACCOUNTING_NUMBER,
			PO_NUMBER,
			PO_LINEITEM,
			INTERNAL_ORDER,
			PURCHASE_ORDER_DATE,
			PO_LINE_DESCRIPTION,
			SUPPLIER_CODE,
			SUPPLIER_NAME,
			SAP_VENDOR_NUMBER,
			ASSET_ID,
			PROFIT_CENTER,
			SERVICE_START_DATE,
			SERVICE_END_DATE,
			COMPANYCODE_CURRENCY,
			DOCUMENT_CURRENCY,
			ORDER_QUANTITY,
			NET_PRICE,
			INVOICE_AMOUNT,
			EXCHANGE_RATE,
			AMOUNT_TO_BE_ACCRUED_CCODE_CURRENCY,
			AMOUNT_TO_BE_ACCRUED_DOC_CURRENCY,
			PO_VALUE,
			SERVICES_COMPLETED_AMOUNT,
			GOODS_RECEIPT_TO_DATE,
			ACCRUAL_METHOD,
			PO_PREPARER,
			PSTYPE_TEXT,
			PO_DASHBOARD_SECTION,
			AMOUNT_ACCRUED_USD,
			STATUS,
			GOODS_RECIEPT_TO_DATE_USD,
			MANAGEMENT_UNIT,
			AMOUNT_ACCRUED,
			STRAIGHT_LINE_MTHD,
			REVIWED_BY,
			CHANGED_ON,
			REGION,
			POCREATEDAT,
			INVOICE_AMOUNT_TO_DATE_USD,
			PERCENTAGE_SERVICE_COMPLETED,
			RULE_TYPE,
			RULE_TYPE_TEXT,
			POVALUE_USD,
			SERVICE_COMPLETED_AMOUNT_USD,
			PR_NUMBER
		)
		(
		SELECT
			"COMPANYCODE",
			"COSTCENTER",
			"GLACCOUNT",
			"POOWNER_EMAIL",
			"KEYDAY",
			"BBP_ACC_NO",
			"PONUMBER",
			"ITEMNO",
			"INTERNALORDER",
			"DOCUMENTDATE",
			"POLINEDESC",
			"SUPPLIERID",
			"SUPPLIERNAME",
			"VENDOR",
			"ASSETID",
			"PROFITCENTER",
			"WRKSTRTDATE",
			"WRKENDDATE",
			"COCDECURR",
			"POCURRENCY",
			"ORDERQUANTITY",
			"POVALUE",
			"InvoiceAmountClearedOrig",
			"EXCHANGERATE",
			"AmountToBeAccruedOrig",
			"AmountToBeAccruedComp",
			PO_VALUE,
			TOTWRKCOMPAMT,
			GRVALUE_1,
			ACCRUALMETHOD,
			PO_PREPARER,
			PSTYPE,
			PO_DASHBOARD_SECTION,
			AMOUNTACCRUED_USD,
			STATUS,
			GRVALUE_USD,
			MANAGEUNIT,
			AMOUNTACCRUED,
			STRAIGHTLINEMTHD,
			REVIWED_BY,
			CHANGED_ON,
			REGION,
			POCREATEDAT,
			INVVALUE_USD,
			TOTWRKCOMPPER,
			RULETYPE,
			RULETYPETEXT,
			POVALUE_USD,
			totWrkCompAmt_usd,
			EPNUMBER
		FROM
			:lt_data
		);

END