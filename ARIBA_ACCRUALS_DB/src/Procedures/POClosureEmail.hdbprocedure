PROCEDURE "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Procedures::POClosureEmail"( )

   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   READS SQL DATA AS
BEGIN

--- Jaoan & Brazil
DECLARE i INTEGER;
DECLARE lv_bukrs VARCHAR(5000);
DECLARE lv_count_jb integer;

 select config_value into lv_bukrs from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.synonyms::ZT_CONFIG_VALUES"
			where config_name = 'Japan_Brazil';

lt_values = select OUTPUT_SPLIT as company_code from "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Functions::TF_splitString"(:lv_bukrs);

--- OPEN PO's' for  service type 
lt_allOpenPOs= SELECT 
  	(case when PSTYPE='0' then 'Indirect Material'
		when PSTYPE='9' then 'Indirect Services'
		end
	)as "PO_DASHBOARD_SECTION",
	"EPNUMBER",
	"GLACCOUNT",
	"POCURRENCY",
	"COSTCENTER",
	"MANAGEUNIT",
	to_date("WRKSTRTDATE") as WRKSTRTDATE,
	PO."PONUMBER",
	to_date("WRKENDDATE") as WRKENDDATE,
	PO."ITEMNO",
	"SUPPLIERID",
	"COMPANYCODE",
	"SUPPLIERNAME",
	"INTERNALORDER",
	"PURCHASINGUNIT",
	"POLINEDESC",
	"ASSETID",
	"REGION",
	--"PSTYPE",
	(case when PSTYPE='0' then 'Material'
		when PSTYPE='9' then 'Service'
		end
	)as "PSTYPE",
	
	"PROFITCENTER",
	"COCDECURR",
	"STATUS",
	--"ACCRUALMETHOD",
	(case when ACCRUALMETHOD='STL' then 'Straight Line'
	 	  when ACCRUALMETHOD='WTD' then 'Work To Date'
		 else ACCRUALMETHOD
	end
	)as "ACCRUALMETHOD",
	
	to_date("POCREATEDAT") as POCREATEDAT,
	"STRAIGHTLINEMTHD",
	PO."POOWNER_EMAIL",
--	"MARKASREVIEWED",
	(case when UPPER(MARKASREVIEWED)='FALSE' then 'No'
		when UPPER(MARKASREVIEWED)='TRUE' then 'Yes'
		end
	)as "MARKASREVIEWED",
	-- to_dats("CHANGEDDATE") as CHANGEDDATE,
	"REVIWED_BY",
	"USERNAME",
	"FULL_NAME",
	"DECIMAL_FORMAT",
	"DATFM",
	PO."PO_PREPARER",
	"BBP_ACC_NO",
	to_date("DOCUMENTDATE") as DOCUMENTDATE,
	"PURCHASINGORGANIZATION",
	"TOTWRKCOMPAMT_CHAR",
	(case when "AMOUNTACCRUED" is null then 0.00 
	else AMOUNTACCRUED
	end ) as AMOUNTACCRUED,
	-- "AMOUNTACCRUED_COCDECURR", To be added in MVP2
	SUM("GRVALUE") AS "GRVALUE",
	SUM("POVALUE_COCO") AS "POVALUE_COCO",
	(case when SUM("TOTWRKCOMPAMT") is null then 0.00 
	else SUM("TOTWRKCOMPAMT")  
	end)AS "TOTWRKCOMPAMT",
	SUM("TOTWRKCOMPPER") AS "TOTWRKCOMPPER",
	SUM("POVALUE") AS "POVALUE",
	SUM("LASTMONTHWRKCOMP") AS "LASTMONTHWRKCOMP",
	SUM("EDGEWTDAMT") AS "EDGEWTDAMT",
	SUM("TOTWRKCOMPAMT_COCDECURR") AS "TOTWRKCOMPAMT_COCDECURR",
	SUM("INVVALUE_COCDECURR") AS "INVVALUE_COCDECURR",
	SUM("GRVALUE_COCDECURR") AS "GRVALUE_COCDECURR",
	SUM("INVVALUE") AS "INVVALUE",
	-- MIN("CHANGEDTIME") AS "CHANGEDTIME",
	SUM("ORDERQUANTITY") AS "ORDERQUANTITY",
	SUM("EXCHANGERATE") AS "EXCHANGERATE",
	"CHANGED_ON" ,
	null  AS "COSTCENTERDESC",
	null  AS "RULETYPE",
	null  AS "RULETYPETEXT",
	-- MVP2
	(case when AMOUNTACCRUED_USD is null then 0.00 
	else AMOUNTACCRUED_USD
	end ) as AMOUNTACCRUED_USD,
	(case when SUM("INVVALUE_USD") is null then 0.00
	else SUM("INVVALUE_USD")
	end)AS "INVVALUE_USD",
	(case when 	SUM("GRVALUE_USD") is null then 0.00
	else 	SUM("GRVALUE_USD")
	end)AS  "GRVALUE_USD",
	(case when SUM("TOTWRKCOMPAMT_USD") is null then 0.00
	else SUM("TOTWRKCOMPAMT_USD")
	end)AS "TOTWRKCOMPAMT_USD",
	(case when SUM("POVALUE_USD") is null then 0.00
	else SUM("POVALUE_USD")
	end )AS "POVALUE_USD",
	PO_CLOSURE
	
	
FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getOpenPO"
	(placeholder."$$IP_PSTYPE$$"=>'9', 
	placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'')AS PO
	where PO_CLOSURE='true'

	
	GROUP BY "EPNUMBER", "GLACCOUNT", "POCURRENCY", "COSTCENTER", "MANAGEUNIT", "WRKSTRTDATE", PO."PONUMBER", 
	"WRKENDDATE", PO."ITEMNO", "SUPPLIERID", "COMPANYCODE", "SUPPLIERNAME", "INTERNALORDER", "PURCHASINGUNIT",
	"POLINEDESC", "ASSETID", "REGION", "PSTYPE", "PROFITCENTER", "COCDECURR", "STATUS", "ACCRUALMETHOD", "POCREATEDAT",
	"STRAIGHTLINEMTHD", PO."POOWNER_EMAIL", "MARKASREVIEWED", "REVIWED_BY", "USERNAME", "FULL_NAME",
	"DECIMAL_FORMAT", "DATFM", PO."PO_PREPARER", "BBP_ACC_NO", "DOCUMENTDATE", "PURCHASINGORGANIZATION", "TOTWRKCOMPAMT_CHAR",
	"AMOUNTACCRUED", "AMOUNTACCRUED_COCDECURR",CHANGED_ON,AMOUNTACCRUED_USD,PO_CLOSURE
union 
-- Open PO's for  material type 
	SELECT 
  	(case when PSTYPE='0' then 'Indirect Material'
		when PSTYPE='9' then 'Indirect Services'
		end
	)as "PO_DASHBOARD_SECTION",
	"EPNUMBER",
	"GLACCOUNT",
	"POCURRENCY",
	"COSTCENTER",
	"MANAGEUNIT",
	to_date("WRKSTRTDATE") as WRKSTRTDATE,
	PO."PONUMBER",
	to_date("WRKENDDATE") as WRKENDDATE,
	PO."ITEMNO",
	"SUPPLIERID",
	"COMPANYCODE",
	"SUPPLIERNAME",
	"INTERNALORDER",
	"PURCHASINGUNIT",
	"POLINEDESC",
	"ASSETID",
	"REGION",
	--"PSTYPE",
	(case when PSTYPE='0' then 'Material'
		when PSTYPE='9' then 'Service'
		end
	)as "PSTYPE",
	
	"PROFITCENTER",
	"COCDECURR",
	"STATUS",
	--"ACCRUALMETHOD",
	(case when ACCRUALMETHOD='STL' then 'Straight Line'
	 	  when ACCRUALMETHOD='WTD' then 'Work To Date'
		 else ACCRUALMETHOD
	end
	)as "ACCRUALMETHOD",
	
	to_date("POCREATEDAT") as POCREATEDAT,
	"STRAIGHTLINEMTHD",
	PO."POOWNER_EMAIL",
--	"MARKASREVIEWED",
	(case when UPPER(MARKASREVIEWED)='FALSE' then 'No'
		when UPPER(MARKASREVIEWED)='TRUE' then 'Yes'
		end
	)as "MARKASREVIEWED",
	-- to_dats("CHANGEDDATE") as CHANGEDDATE,
	"REVIWED_BY",
	"USERNAME",
	"FULL_NAME",
	"DECIMAL_FORMAT",
	"DATFM",
	PO."PO_PREPARER",
	"BBP_ACC_NO",
	to_date("DOCUMENTDATE") as DOCUMENTDATE,
	"PURCHASINGORGANIZATION",
	"TOTWRKCOMPAMT_CHAR",
	(case when "AMOUNTACCRUED" is null then 0.00 
	else AMOUNTACCRUED
	end ) as AMOUNTACCRUED,
	-- "AMOUNTACCRUED_COCDECURR", To be added in MVP2
	SUM("GRVALUE") AS "GRVALUE",
	SUM("POVALUE_COCO") AS "POVALUE_COCO",
	(case when SUM("TOTWRKCOMPAMT") is null then 0.00 
	else SUM("TOTWRKCOMPAMT")  
	end)AS "TOTWRKCOMPAMT",
	SUM("TOTWRKCOMPPER") AS "TOTWRKCOMPPER",
	SUM("POVALUE") AS "POVALUE",
	SUM("LASTMONTHWRKCOMP") AS "LASTMONTHWRKCOMP",
	SUM("EDGEWTDAMT") AS "EDGEWTDAMT",
	SUM("TOTWRKCOMPAMT_COCDECURR") AS "TOTWRKCOMPAMT_COCDECURR",
	SUM("INVVALUE_COCDECURR") AS "INVVALUE_COCDECURR",
	SUM("GRVALUE_COCDECURR") AS "GRVALUE_COCDECURR",
	SUM("INVVALUE") AS "INVVALUE",
	-- MIN("CHANGEDTIME") AS "CHANGEDTIME",
	SUM("ORDERQUANTITY") AS "ORDERQUANTITY",
	SUM("EXCHANGERATE") AS "EXCHANGERATE",
	"CHANGED_ON" ,
	null  AS "COSTCENTERDESC",
	null  AS "RULETYPE",
	null  AS "RULETYPETEXT",
	-- MVP2
	(case when AMOUNTACCRUED_USD is null then 0.00 
	else AMOUNTACCRUED_USD
	end ) as AMOUNTACCRUED_USD,
	(case when SUM("INVVALUE_USD") is null then 0.00
	else SUM("INVVALUE_USD")
	end)AS "INVVALUE_USD",
	(case when 	SUM("GRVALUE_USD") is null then 0.00
	else 	SUM("GRVALUE_USD")
	end)AS  "GRVALUE_USD",
	(case when SUM("TOTWRKCOMPAMT_USD") is null then 0.00
	else SUM("TOTWRKCOMPAMT_USD")
	end)AS "TOTWRKCOMPAMT_USD",
		(case when SUM("POVALUE_USD") is null then 0.00
	else SUM("POVALUE_USD")
	end )AS "POVALUE_USD",
	-- (CASE WHEN PO_CLOSURE IS NULL then 'No'
	-- 	WHEN PO_CLOSURE ='false' then 'No'
	-- 	WHEN PO_CLOSURE ='true' then 'Yes'
	-- end) as 
	PO_CLOSURE

FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getOpenPO"
	(placeholder."$$IP_PSTYPE$$"=>'0', 
	placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'')AS PO
	where PO_CLOSURE='true'


	
	GROUP BY "EPNUMBER", "GLACCOUNT", "POCURRENCY", "COSTCENTER", "MANAGEUNIT", "WRKSTRTDATE", PO."PONUMBER", 
	"WRKENDDATE", PO."ITEMNO", "SUPPLIERID", "COMPANYCODE", "SUPPLIERNAME", "INTERNALORDER", "PURCHASINGUNIT",
	"POLINEDESC", "ASSETID", "REGION", "PSTYPE", "PROFITCENTER", "COCDECURR", "STATUS", "ACCRUALMETHOD", "POCREATEDAT",
	"STRAIGHTLINEMTHD", PO."POOWNER_EMAIL", "MARKASREVIEWED", "REVIWED_BY", "USERNAME", "FULL_NAME",
	"DECIMAL_FORMAT", "DATFM", PO."PO_PREPARER", "BBP_ACC_NO", "DOCUMENTDATE", "PURCHASINGORGANIZATION", "TOTWRKCOMPAMT_CHAR",
	"AMOUNTACCRUED", "AMOUNTACCRUED_COCDECURR",CHANGED_ON,AMOUNTACCRUED_USD,PO_CLOSURE
UNION
-- Below Threshold
SELECT 
	(case when PSTYPE='0' then 'Below Threshold PO Material'
		when PSTYPE='9' then 'Below Threshold PO Service'
		end
	)as "PO_DASHBOARD_SECTION",
	"EPNUMBER",
	"GLACCOUNT",
	"POCURRENCY",
	"COSTCENTER",
	"MANAGEUNIT",
	to_date("WRKSTRTDATE") as WRKSTRTDATE,
	PO."PONUMBER",
	to_date("WRKENDDATE") as WRKENDDATE,
	PO."ITEMNO",
	"SUPPLIERID",
	"COMPANYCODE",
	"SUPPLIERNAME",
	"INTERNALORDER",
	"PURCHASINGUNIT",
	"POLINEDESC",
	"ASSETID",
	"REGION",
	--"PSTYPE",
	(case when PSTYPE='0' then 'Material'
		when PSTYPE='9' then 'Service'
		end
	)as "PSTYPE",
	"PROFITCENTER",
	"COCDECURR",
	"STATUS",
	--"ACCRUALMETHOD",
	(case when ACCRUALMETHOD='STL' then 'Straight Line'
	 	  when ACCRUALMETHOD='WTD' then 'Work To Date'
		 else ACCRUALMETHOD
	end
	)as "ACCRUALMETHOD",
	to_date("POCREATEDAT") as POCREATEDAT,
	"STRAIGHTLINEMTHD",
	PO."POOWNER_EMAIL",
	--"MARKASREVIEWED",
	(case when UPPER(MARKASREVIEWED)='FALSE' then 'No'
		when UPPER(MARKASREVIEWED)='TRUE' then 'Yes'
		end
	)as "MARKASREVIEWED",
	-- to_dats("CHANGEDDATE") as CHANGEDDATE,
	"REVIWED_BY",
	"USERNAME",
	"FULL_NAME",
	"DECIMAL_FORMAT",
	"DATFM",
	PO."PO_PREPARER",
	 "BBP_ACC_NO",
	 to_date("DOCUMENTDATE") as DOCUMENTDATE,
	 "PURCHASINGORGANIZATION",
	(case when to_varchar(SUM("TOTWRKCOMPAMT")) is null then '0.00'
	else to_varchar(SUM("TOTWRKCOMPAMT")) 
	end)AS  "TOTWRKCOMPAMT_CHAR",
	(case when "AMOUNTACCRUED" is null then 0.00 
	else AMOUNTACCRUED
	end ) as AMOUNTACCRUED,
	-- "AMOUNTACCRUED_COCDECURR",To be added in MVP2
	SUM("GRVALUE") AS "GRVALUE",
	SUM("POVALUE_COCO") AS "POVALUE_COCO",
	(case when SUM("TOTWRKCOMPAMT") is null then 0.00 
	else SUM("TOTWRKCOMPAMT")  
	end)AS "TOTWRKCOMPAMT",
	SUM("TOTWRKCOMPPER") AS "TOTWRKCOMPPER",
	SUM("POVALUE") AS "POVALUE",
	SUM("LASTMONTHWRKCOMP") AS "LASTMONTHWRKCOMP",
	SUM("EDGEWTDAMT") AS "EDGEWTDAMT",
	SUM("TOTWRKCOMPAMT_COCDECURR") AS "TOTWRKCOMPAMT_COCDECURR",
	SUM("INVVALUE_COCDECURR") AS "INVVALUE_COCDECURR",
	SUM("GRVALUE_COCDECURR") AS "GRVALUE_COCDECURR",
	SUM("INVVALUE") AS "INVVALUE",
	-- MIN("CHANGEDTIME") AS "CHANGEDTIME",
	SUM("ORDERQUANTITY") AS "ORDERQUANTITY",
	SUM("EXCHANGERATE") AS "EXCHANGERATE",
	 	"CHANGED_ON" ,
	null  AS "COSTCENTERDESC",
	null  AS "RULETYPE",
	null  AS "RULETYPETEXT",
	-- MVP2
	(case when AMOUNTACCRUED_USD is null then 0.00 
	else AMOUNTACCRUED_USD
	end ) as AMOUNTACCRUED_USD,
	(case when SUM("INVVALUE_USD") is null then 0.00
	else SUM("INVVALUE_USD")
	end)AS "INVVALUE_USD",
	(case when 	SUM("GRVALUE_USD") is null then 0.00
	else SUM("GRVALUE_USD")
	end)AS  "GRVALUE_USD",
	(case when SUM("TOTWRKCOMPAMT_USD") is null then 0.00
	else SUM("TOTWRKCOMPAMT_USD")
	end)AS "TOTWRKCOMPAMT_USD",
	(case when SUM("POVALUE_USD") is null then 0.00
	else SUM("POVALUE_USD")
	end )AS "POVALUE_USD",
	-- (CASE WHEN PO_CLOSURE IS NULL then 'No'
	-- 	WHEN PO_CLOSURE ='false' then 'No'
	-- 	WHEN PO_CLOSURE ='true' then 'Yes'
	-- end) as
	PO_CLOSURE
	
FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getThresholdPO"
	(placeholder."$$IP_PSTYPE$$"=>'9', 
	placeholder."$$IP_EMAIL$$"=>'*',
	placeholder."$$IP_POOWNER$$"=>'') AS PO
	where PO_CLOSURE='true'


	
	GROUP BY "EPNUMBER", "GLACCOUNT", "POCURRENCY", "COSTCENTER", "MANAGEUNIT", "WRKSTRTDATE", PO."PONUMBER", 
	"WRKENDDATE", PO."ITEMNO", "SUPPLIERID", "COMPANYCODE", "SUPPLIERNAME", "INTERNALORDER",
	"PURCHASINGUNIT", "POLINEDESC", "ASSETID", "REGION", "PSTYPE", "PROFITCENTER", "COCDECURR", 
	"STATUS", "ACCRUALMETHOD", "POCREATEDAT", "STRAIGHTLINEMTHD", PO."POOWNER_EMAIL", "MARKASREVIEWED",
    "REVIWED_BY", "USERNAME", "FULL_NAME", "DECIMAL_FORMAT", "DATFM", PO."PO_PREPARER","BBP_ACC_NO",
	 "DOCUMENTDATE",CHANGED_ON,
	 "PURCHASINGORGANIZATION", "AMOUNTACCRUED", "AMOUNTACCRUED_COCDECURR",AMOUNTACCRUED_USD,PO_CLOSURE
	 
union

SELECT 
	(case when PSTYPE='0' then 'Below Threshold PO Material'
		when PSTYPE='9' then 'Below Threshold PO Service'
		end
	)as "PO_DASHBOARD_SECTION",
	"EPNUMBER",
	"GLACCOUNT",
	"POCURRENCY",
	"COSTCENTER",
	"MANAGEUNIT",
	to_date("WRKSTRTDATE") as WRKSTRTDATE,
	PO."PONUMBER",
	to_date("WRKENDDATE") as WRKENDDATE,
	PO."ITEMNO",
	"SUPPLIERID",
	"COMPANYCODE",
	"SUPPLIERNAME",
	"INTERNALORDER",
	"PURCHASINGUNIT",
	"POLINEDESC",
	"ASSETID",
	"REGION",
	--"PSTYPE",
	(case when PSTYPE='0' then 'Material'
		when PSTYPE='9' then 'Service'
		end
	)as "PSTYPE",
	"PROFITCENTER",
	"COCDECURR",
	"STATUS",
	--"ACCRUALMETHOD",
	(case when ACCRUALMETHOD='STL' then 'Straight Line'
	 	  when ACCRUALMETHOD='WTD' then 'Work To Date'
		 else ACCRUALMETHOD
	end
	)as "ACCRUALMETHOD",
	to_date("POCREATEDAT") as POCREATEDAT,
	"STRAIGHTLINEMTHD",
	PO."POOWNER_EMAIL",
	--"MARKASREVIEWED",
	(case when UPPER(MARKASREVIEWED)='FALSE' then 'No'
		when UPPER(MARKASREVIEWED)='TRUE' then 'Yes'
		end
	)as "MARKASREVIEWED",
	-- to_dats("CHANGEDDATE") as CHANGEDDATE,
	"REVIWED_BY",
	"USERNAME",
	"FULL_NAME",
	"DECIMAL_FORMAT",
	"DATFM",
	PO."PO_PREPARER",
	 "BBP_ACC_NO",
	 to_date("DOCUMENTDATE") as DOCUMENTDATE,
	 "PURCHASINGORGANIZATION",
	(case when to_varchar(SUM("TOTWRKCOMPAMT")) is null then '0.00'
	else to_varchar(SUM("TOTWRKCOMPAMT")) 
	end)AS  "TOTWRKCOMPAMT_CHAR",
	(case when "AMOUNTACCRUED" is null then 0.00 
	else AMOUNTACCRUED
	end ) as AMOUNTACCRUED,
	-- "AMOUNTACCRUED_COCDECURR",To be added in MVP2
	SUM("GRVALUE") AS "GRVALUE",
	SUM("POVALUE_COCO") AS "POVALUE_COCO",
	(case when SUM("TOTWRKCOMPAMT") is null then 0.00 
	else SUM("TOTWRKCOMPAMT")  
	end)AS "TOTWRKCOMPAMT",
	SUM("TOTWRKCOMPPER") AS "TOTWRKCOMPPER",
	SUM("POVALUE") AS "POVALUE",
	SUM("LASTMONTHWRKCOMP") AS "LASTMONTHWRKCOMP",
	SUM("EDGEWTDAMT") AS "EDGEWTDAMT",
	SUM("TOTWRKCOMPAMT_COCDECURR") AS "TOTWRKCOMPAMT_COCDECURR",
	SUM("INVVALUE_COCDECURR") AS "INVVALUE_COCDECURR",
	SUM("GRVALUE_COCDECURR") AS "GRVALUE_COCDECURR",
	SUM("INVVALUE") AS "INVVALUE",
	-- MIN("CHANGEDTIME") AS "CHANGEDTIME",
	SUM("ORDERQUANTITY") AS "ORDERQUANTITY",
	SUM("EXCHANGERATE") AS "EXCHANGERATE",
	 	"CHANGED_ON" ,
	null  AS "COSTCENTERDESC",
	null  AS "RULETYPE",
	null  AS "RULETYPETEXT",
	-- MVP2
	(case when AMOUNTACCRUED_USD is null then 0.00 
	else AMOUNTACCRUED_USD
	end ) as AMOUNTACCRUED_USD,
	(case when SUM("INVVALUE_USD") is null then 0.00
	else SUM("INVVALUE_USD")
	end)AS "INVVALUE_USD",
	(case when 	SUM("GRVALUE_USD") is null then 0.00
	else SUM("GRVALUE_USD")
	end)AS  "GRVALUE_USD",
	(case when SUM("TOTWRKCOMPAMT_USD") is null then 0.00
	else SUM("TOTWRKCOMPAMT_USD")
	end)AS "TOTWRKCOMPAMT_USD",
	(case when SUM("POVALUE_USD") is null then 0.00
	else SUM("POVALUE_USD")
	end )AS "POVALUE_USD",
	-- (CASE WHEN PO_CLOSURE IS NULL then 'No'
	-- 	WHEN PO_CLOSURE ='false' then 'No'
	-- 	WHEN PO_CLOSURE ='true' then 'Yes'
	-- end) as
	PO_CLOSURE
	
FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getThresholdPO"
	(placeholder."$$IP_PSTYPE$$"=>'0', 
	placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'') AS PO
	where PO_CLOSURE='true'


	
	GROUP BY "EPNUMBER", "GLACCOUNT", "POCURRENCY", "COSTCENTER", "MANAGEUNIT", "WRKSTRTDATE", PO."PONUMBER", 
	"WRKENDDATE", PO."ITEMNO", "SUPPLIERID", "COMPANYCODE", "SUPPLIERNAME", "INTERNALORDER",
	"PURCHASINGUNIT", "POLINEDESC", "ASSETID", "REGION", "PSTYPE", "PROFITCENTER", "COCDECURR", 
	"STATUS", "ACCRUALMETHOD", "POCREATEDAT", "STRAIGHTLINEMTHD", PO."POOWNER_EMAIL", "MARKASREVIEWED",
    "REVIWED_BY", "USERNAME", "FULL_NAME", "DECIMAL_FORMAT", "DATFM", PO."PO_PREPARER","BBP_ACC_NO",
	 "DOCUMENTDATE",CHANGED_ON,
	 "PURCHASINGORGANIZATION", "AMOUNTACCRUED", "AMOUNTACCRUED_COCDECURR",AMOUNTACCRUED_USD,PO_CLOSURE
UNION
-- Exclusion
SELECT 
	(case when PSTYPE='0' then 'Exclusion Indirect Material'
		when PSTYPE='9' then 'Exclusion Indirect Service'
		end
	)as "PO_DASHBOARD_SECTION",
   	"EPNUMBER",
   "GLACCOUNT",
   	"POCURRENCY",
   	"COSTCENTER",
   	"MANAGEUNIT",
   	to_date("WRKSTRTDATE") as WRKSTRTDATE,
	PO."PONUMBER",
	to_date("WRKENDDATE") as WRKENDDATE,
	PO."ITEMNO",
	"SUPPLIERID",
	"COMPANYCODE",
	"SUPPLIERNAME",
	"INTERNALORDER",
	"PURCHASINGUNIT",
	"POLINEDESC",
	"ASSETID",
	"REGION",
	--"PSTYPE",
	(case when PSTYPE='0' then 'Material'
		when PSTYPE='9' then 'Service'
		end
	)as "PSTYPE",
	"PROFITCENTER",
	"COCDECURR",
	"STATUS",
	--"ACCRUALMETHOD",
	(case when ACCRUALMETHOD='STL' then 'Straight Line'
	 	  when ACCRUALMETHOD='WTD' then 'Work To Date'
		 else ACCRUALMETHOD
	end
	)as "ACCRUALMETHOD",
	to_date("POCREATEDAT") as POCREATEDAT,
	"STRAIGHTLINEMTHD",
	 "POOWNER_EMAIL",
	null AS "MARKASREVIEWED",
	-- null as "CHANGEDDATE",
	null AS "REVIWED_BY",
	null AS "USERNAME",
	
	null AS "FULL_NAME",
	null AS "DECIMAL_FORMAT",
	null AS"DATFM",
	PO."PO_PREPARER",
	null AS "BBP_ACC_NO",
	to_date("DOCUMENTDATE") as DOCUMENTDATE,
	null AS "PURCHASINGORGANIZATION",
	(case when to_varchar(SUM("TOTWRKCOMPAMT")) is null then '0.00'
	else to_varchar(SUM("TOTWRKCOMPAMT")) 
	end)AS  "TOTWRKCOMPAMT_CHAR",
	'0.00' AS "AMOUNTACCRUED",
	-- null AS "AMOUNTACCRUED_COCDECURR",To be added in MVP2
	 "GRVALUE",
	 "POVALUE_COCO",
	(case when SUM("TOTWRKCOMPAMT") is null then 0.00 
	else SUM("TOTWRKCOMPAMT")  
	end)AS "TOTWRKCOMPAMT",
	 "TOTWRKCOMPPER",
	"POVALUE",
	 "LASTMONTHWRKCOMP",
	null AS "EDGEWTDAMT",
	null AS "TOTWRKCOMPAMT_COCDECURR",
	null  AS "INVVALUE_COCDECURR",
	null  AS "GRVALUE_COCDECURR",
	"INVVALUE",
	-- null AS "CHANGEDTIME",
	null  as "ORDERQUANTITY",
	 "EXCHANGERATE",
	 	"CHANGED_ON" ,
   "COSTCENTERDESC",
	"RULETYPE",
	"RULETYPETEXT",
	-- MVP2
	'0.00' as AMOUNTACCRUED_USD,
	(case when SUM("INVVALUE_USD") is null then 0.00
	else SUM("INVVALUE_USD")
	end)AS "INVVALUE_USD",
	(case when 	SUM("GRVALUE_USD") is null then 0.00
	else 	SUM("GRVALUE_USD")
	end)AS  "GRVALUE_USD",
	(case when SUM("TOTWRKCOMPAMT_USD") is null then 0.00
	else SUM("TOTWRKCOMPAMT_USD")
	end)AS "TOTWRKCOMPAMT_USD",
	(case when SUM("POVALUE_USD") is null then 0.00
	else SUM("POVALUE_USD")
	end )AS "POVALUE_USD",
	-- (CASE WHEN PO_CLOSURE IS NULL then 'No'
	-- 	WHEN PO_CLOSURE ='false' then 'No'
	-- 	WHEN PO_CLOSURE ='true' then 'Yes'
	-- end) as 
	PO_CLOSURE
FROM "ARIBA_ACCRUAL.ARIBA_ACCRUALS_DB.Models::CV_getExclusionPO"
	(placeholder."$$IP_EMAIL$$"=>'*', 
	placeholder."$$IP_POOWNER$$"=>'')AS PO
	where PO_CLOSURE='true'

	GROUP BY "EPNUMBER",WRKSTRTDATE,WRKENDDATE,"GLACCOUNT",	"POCURRENCY",
   	"COSTCENTER",
   	"MANAGEUNIT",PO."PONUMBER",PO."ITEMNO",	PO."PO_PREPARER",
	"SUPPLIERID",
	"COMPANYCODE",
	"SUPPLIERNAME",
	"INTERNALORDER",
	"PURCHASINGUNIT",
	"POLINEDESC",
	"ASSETID",
	"REGION",
	"PSTYPE",
	"PROFITCENTER",
	"COCDECURR",
	"STATUS",CHANGED_ON,
	"ACCRUALMETHOD",
	"POCREATEDAT",INVVALUE,
	"STRAIGHTLINEMTHD",
	POOWNER_EMAIL,"GRVALUE",
	 "POVALUE_COCO",
	"TOTWRKCOMPAMT",
	 "TOTWRKCOMPPER",
	"POVALUE",
	 "COSTCENTERDESC",
	"RULETYPE",
	"RULETYPETEXT",
	 "LASTMONTHWRKCOMP",
	 EXCHANGERATE,
	 DOCUMENTDATE,
	 PO_CLOSURE;
	 
------ Japan and Brazil Logic -----

lt_openPOs_njb = select * from :lt_allOpenPOs where companycode not in (select company_code from :lt_values);

lt_openPOs_jb = select * from :lt_allOpenPOs where companycode in (select company_code from :lt_values);

select count(*) into lv_count_jb from :lt_openPOs_jb where 
PO_DASHBOARD_SECTION like '%Material%'
and WRKSTRTDATE <> '00000000';

IF (:lv_count_jb <> '0') THEN	

	FOR i IN 1 .. RECORD_COUNT(:lt_openPOs_jb) 
	Do
	
	IF(:lt_openPOs_jb.PO_DASHBOARD_SECTION[i] = 'Indirect Material' AND :lt_openPOs_jb.WRKSTRTDATE[i] <> '00000000') THEN
	 
		lt_openPOs_jb."PO_DASHBOARD_SECTION"[i] := 'Indirect Services';
		lt_openPOs_jb."PSTYPE"[i] := 'Service';
	
	ELSE IF(:lt_openPOs_jb.PO_DASHBOARD_SECTION[i] = 'Below Threshold PO Material' AND :lt_openPOs_jb.WRKSTRTDATE[i] <> '00000000') THEN
	
		lt_openPOs_jb."PO_DASHBOARD_SECTION"[i] := 'Below Threshold PO Services';
		lt_openPOs_jb."PSTYPE"[i] := 'Service';
	
	ELSE IF(:lt_openPOs_jb.PO_DASHBOARD_SECTION[i] = 'Exclusion Indirect Material' AND :lt_openPOs_jb.WRKSTRTDATE[i] <> '00000000') THEN
	
		lt_openPOs_jb."PO_DASHBOARD_SECTION"[i] := 'Exclusion Indirect Services';
		lt_openPOs_jb."PSTYPE"[i] := 'Service';
		
	END IF;
	END IF;
	END IF;
	
	END FOR;

lt_allOpenPOs = select * from :lt_openPOs_njb union all select * from :lt_openPOs_jb;	

END IF;	 
	
select * from :lt_allOpenPOs
order by companycode;

END